# Copy to /etc/csd-pool/node.env and restrict permissions to root:csd-node 0640.
CSD_POOL_NODE_TOKEN=change-me-node-token
CSD_POOL_NODE_BINARY=/opt/csd-node/bin/csd
CSD_POOL_NODE_DATADIR=/var/lib/csd-node
CSD_POOL_NODE_GENESIS=/etc/csd-node/genesis.bin
CSD_POOL_NODE_RPC=127.0.0.1:8789
CSD_POOL_NODE_P2P_LISTEN=/ip4/0.0.0.0/tcp/17999
CSD_POOL_NODE_BOOTNODES=
