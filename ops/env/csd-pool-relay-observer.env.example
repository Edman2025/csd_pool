# Render a host-specific copy only after the candidate resource/network gate passes.
CSD_RELAY_OBSERVER_TOKEN=change-me-observer-token
CSD_RELAY_OBSERVER_BINARY=/opt/csd-relay-observer/bin/csd
CSD_RELAY_OBSERVER_DATADIR=/var/lib/csd-relay-observer
CSD_RELAY_OBSERVER_GENESIS=/etc/csd-relay-observer/genesis.bin
CSD_RELAY_OBSERVER_RPC=127.0.0.1:18789
CSD_RELAY_OBSERVER_P2P_LISTEN=/ip4/127.0.0.1/tcp/0
CSD_RELAY_OBSERVER_BOOTNODES=
# Candidate-specific hard ceiling. The first canary value is rendered from measured free space.
CSD_RELAY_OBSERVER_DISK_BUDGET_BYTES=17179869184
