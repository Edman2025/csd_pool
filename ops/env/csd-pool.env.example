# Copy to /etc/csd-pool/csd-pool.env and restrict permissions to root:csd-pool 0640.
CSD_POOL_CONFIG=/etc/csd-pool/config.toml
CSD_POOL_DATABASE_URL=postgres://csd_pool:change-me@127.0.0.1:5432/csd_pool
CSD_POOL_REDIS_URL=redis://127.0.0.1:6379/0
CSD_POOL_TEMPLATE_MODE=live
CSD_POOL_TEMPLATE_REFRESH_SECS=2
CSD_POOL_SUBMIT_CANDIDATES=true
# Shared bearer token for the patched official CSD node mining adapter.
# Configure the same value as CSD_POOL_ADAPTER_TOKEN on every adapter node.
CSD_POOL_NODE_TOKEN=change-me-node-token
CSD_POOL_PUBLIC_STRATUM_ADDR=pool.example.com:3333
CSD_POOL_PUBLIC_API_URL=https://pool.example.com
# Go-live edge proxy safety validates the target HAProxy config, public Stratum
# bind, loopback API/Stratum backends, rate limit, and health check.
CSD_POOL_HAPROXY_CONFIG=/etc/haproxy/haproxy.cfg
# Go-live TLS safety requires public API certificate validity remaining.
CSD_POOL_PUBLIC_API_TLS_MIN_VALID_DAYS=14
# Format: port:name:difficulty[:disabled], comma separated.
CSD_POOL_PUBLIC_PORT_TIERS=3333:standard:8,5555:high:64:disabled,7777:rental:256:disabled
CSD_POOL_OPERATOR_TOKEN=change-me-operator-token
CSD_POOL_SIGNER_URL=http://127.0.0.1:8890
CSD_POOL_SIGNER_TOKEN=change-me-signer-token
CSD_POOL_SIGNER_WALLET_ADDRESS=0123456789abcdef0123456789abcdef01234567
# The production wallet signer reads this 0600 file as the csd-signer user.
CSD_POOL_SIGNER_PRIVATE_KEY_FILE=/etc/csd-pool/signer-wallet.key
# Direct CSD RPC base used by the official SDK for UTXO lookup and verification.
CSD_POOL_SIGNER_NODE_URL=http://127.0.0.1:8789
CSD_POOL_SIGNER_LISTEN=127.0.0.1:8890
CSD_POOL_SIGNER_FEE_BASE_UNITS=200000
CSD_POOL_SIGNER_MAX_BATCH_BASE_UNITS=100000000000
CSD_POOL_WATCH_NODE_URL=http://127.0.0.1:8790
CSD_POOL_SUBMIT_NODE_URL=http://127.0.0.1:8790
# Direct official CSD RPC base for signed payout transaction broadcast.
CSD_POOL_PAYOUT_NODE_URL=http://127.0.0.1:8789
CSD_POOL_NETWORK_URL=https://cairn-substrate.com
# Optional bearer token dedicated to the network telemetry endpoint. The
# private node adapter token is never sent to CSD_POOL_NETWORK_URL.
# CSD_POOL_NETWORK_TOKEN=
CSD_POOL_STUCK_PAYOUT_MINUTES=60
CSD_POOL_BACKUP_DIR=/var/backups/csd-pool
# Go-live disk safety defaults require 5 GiB and 10000 inodes free on each
# checked filesystem. Raise these for public-beta/production capacity plans.
CSD_POOL_DISK_MIN_FREE_BYTES=5368709120
CSD_POOL_DISK_MIN_FREE_INODES=10000
# Go-live database runtime safety checks query and transaction latency.
CSD_POOL_DATABASE_RUNTIME_MAX_QUERY_MS=1000
CSD_POOL_DATABASE_RUNTIME_MAX_TRANSACTION_MS=1000
# Go-live CSD node runtime safety checks role quorum and RPC latency.
CSD_POOL_NODE_RUNTIME_MIN_TEMPLATE_NODES=1
CSD_POOL_NODE_RUNTIME_MIN_SUBMIT_NODES=2
CSD_POOL_NODE_RUNTIME_MIN_WATCH_NODES=2
CSD_POOL_NODE_RUNTIME_MAX_HEALTH_MS=2000
CSD_POOL_NODE_RUNTIME_MAX_NETWORK_MS=3000
CSD_POOL_NODE_RUNTIME_MAX_TEMPLATE_MS=5000
# Go-live resource limit safety checks systemd and live process nofile limits.
CSD_POOL_DAEMON_MIN_NOFILE=65536
CSD_POOL_SIGNER_MIN_NOFILE=4096
# Go-live runtime hardening safety expects these service identities.
CSD_POOL_DAEMON_EXPECTED_USER=csd-pool
CSD_POOL_DAEMON_EXPECTED_GROUP=csd-pool
CSD_POOL_SIGNER_EXPECTED_USER=csd-signer
CSD_POOL_SIGNER_EXPECTED_GROUP=csd-signer
# Optional comma-separated extra secret files checked by go-live permissions
# safety, such as signer wallet files or reverse-proxy private key material.
# Each listed file must be owner-readable and have no group/other permissions.
CSD_POOL_SECRET_FILES=/etc/csd-pool/signer-wallet.key
# Optional: include the PostgreSQL data filesystem in go-live disk evidence.
# CSD_POOL_POSTGRES_DATA_DIR=/var/lib/postgresql/16/main
# Installed releases also load /opt/csd-pool/release.env with
# CSD_POOL_RELEASE_NAME, CSD_POOL_RELEASE_REVISION, and
# CSD_POOL_RELEASE_TIMESTAMP_UTC for runtime evidence binding.
# Optional one-off backup path override. Leave unset for timestamped files.
# CSD_POOL_BACKUP_PATH=/var/backups/csd-pool/csd_pool.dump
