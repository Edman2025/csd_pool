# V15 is fail-closed and disabled by default.
CSD_EXTERNAL_RELAY_V15_ENABLED=false
CSD_EXTERNAL_RELAY_V15_MODE=ANNOUNCE_THEN_PULL

# Populate only from an independently sealed host inventory. Never reuse A/B/C.
CSD_EXTERNAL_RELAY_V15_D_ENDPOINT_SECRET_REF=
CSD_EXTERNAL_RELAY_V15_D_PUBLIC_KEY_REF=
CSD_EXTERNAL_RELAY_V15_E_ENDPOINT_SECRET_REF=
CSD_EXTERNAL_RELAY_V15_E_PUBLIC_KEY_REF=

# Bounded, fail-open sender limits.
CSD_EXTERNAL_RELAY_V15_DEADLINE_MS=2000
CSD_EXTERNAL_RELAY_V15_MAX_INFLIGHT=8
CSD_EXTERNAL_RELAY_V15_MAX_TRACKED=512
