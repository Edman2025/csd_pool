[Unit]
Description=CSD Pool payout batch creation
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=csd-pool
Group=csd-pool
WorkingDirectory=/opt/csd-pool
EnvironmentFile=/etc/csd-pool/csd-pool.env
EnvironmentFile=-/opt/csd-pool/release.env
ExecStart=/opt/csd-pool/bin/csd-pool-workers create-payouts
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/csd-pool /var/lib/csd-pool
