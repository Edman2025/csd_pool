+
+fn expected_dial_failure_reason(error: &str) -> Option<&'static str> {
+    if error.contains("TimedOut") || error.contains("Connection timed out") {
+        Some("timeout")
+    } else if error.contains("ConnectionRefused") {
+        Some("connection_refused")
+    } else if error.contains("NetworkUnreachable") || error.contains("Network is unreachable") {
+        Some("network_unreachable")
+    } else if error.contains("NoAddresses") {
+        Some("no_addresses")
+    } else {
+        None
+    }
+}
