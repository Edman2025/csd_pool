+type PendingDials = HashMap<PeerId, HashMap<Multiaddr, Instant>>;
+
+fn note_pending_dial_at(
+    pending_dials: &mut PendingDials,
     peer: PeerId,
     addr: Multiaddr,
+    now: Instant,
 ) {
-    pending_dials.entry(peer).or_default().insert(addr);
+    pending_dials.entry(peer).or_default().insert(addr, now);
 }
 
+fn note_pending_dial(pending_dials: &mut PendingDials, peer: PeerId, addr: Multiaddr) {
+    note_pending_dial_at(pending_dials, peer, addr, Instant::now());
+}
+
+fn addr_dial_is_pending_at(
+    pending_dials: &PendingDials,
+    peer: &PeerId,
+    addr: &Multiaddr,
+    now: Instant,
+) -> bool {
+    pending_dials
+        .get(peer)
+        .and_then(|addrs| addrs.get(addr))
+        .map(|started_at| {
+            now.saturating_duration_since(*started_at)
+                < Duration::from_secs(PENDING_DIAL_RETENTION_SECS)
+        })
+        .unwrap_or(false)
+}
+
+fn addr_dial_is_pending(
+    pending_dials: &PendingDials,
+    peer: &PeerId,
+    addr: &Multiaddr,
+) -> bool {
+    addr_dial_is_pending_at(pending_dials, peer, addr, Instant::now())
+}
