+fn record_dial_submission<E: std::fmt::Debug>(
+    result: std::result::Result<(), E>,
+    pending_dials: &mut PendingDials,
+    addr_backoff: &mut HashMap<Multiaddr, AddrDialBackoff>,
+    peer: Option<PeerId>,
+    addr: &Multiaddr,
+) -> bool {
+    match result {
+        Ok(()) => {
+            if let Some(peer) = peer {
+                note_pending_dial(pending_dials, peer, addr.clone());
+            }
+            true
+        }
+        Err(error) => {
+            let error_debug = format!("{:?}", error);
+            let state = note_addr_dial_failure(addr_backoff, addr);
+            let retry_in_secs = addr_backoff_secs(state.failures);
+            if let Some(reason) = expected_dial_failure_reason(&error_debug) {
+                println!(
+                    "[p2p] dial_enqueue_failed peer={} addr={} reason={} failures={} retry_in_secs={}",
+                    peer.map(|value| value.to_string())
+                        .unwrap_or_else(|| "unknown".to_string()),
+                    addr,
+                    reason,
+                    state.failures,
+                    retry_in_secs
+                );
+            } else {
+                println!(
+                    "[p2p] dial_enqueue_failed peer={} addr={} failures={} retry_in_secs={} err={}",
+                    peer.map(|value| value.to_string())
+                        .unwrap_or_else(|| "unknown".to_string()),
+                    addr,
+                    state.failures,
+                    retry_in_secs,
+                    error_debug
+                );
+            }
+            false
+        }
+    }
+}
