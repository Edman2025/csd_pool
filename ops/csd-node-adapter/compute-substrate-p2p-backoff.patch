+#[cfg(test)]
+mod dial_backoff_tests {
+    use super::*;
+
+    fn test_addr() -> Multiaddr {
+        "/ip4/203.0.113.10/tcp/17999".parse().unwrap()
+    }
+
+    #[test]
+    fn dial_backoff_increases_after_expiry_instead_of_resetting() {
+        let now = Instant::now();
+        let first = next_addr_dial_backoff(None, now);
+        assert_eq!(first.failures, 1);
+        assert_eq!(
+            first.retry_at.saturating_duration_since(now),
+            Duration::from_secs(30)
+        );
+
+        let second = next_addr_dial_backoff(
+            Some(&first),
+            now + Duration::from_secs(31),
+        );
+        assert_eq!(second.failures, 2);
+        assert_eq!(
+            second
+                .retry_at
+                .saturating_duration_since(now + Duration::from_secs(31)),
+            Duration::from_secs(120)
+        );
+    }
+
+    #[test]
+    fn expired_retry_deadline_is_retained_for_failure_history() {
+        let now = Instant::now();
+        let addr = test_addr();
+        let mut backoff = HashMap::from([(
+            addr.clone(),
+            AddrDialBackoff {
+                failures: 4,
+                retry_at: now - Duration::from_secs(1),
+                last_failure_at: now - Duration::from_secs(901),
+            },
+        )]);
+
+        prune_addr_backoff_at(&mut backoff, now);
+
+        assert!(backoff.contains_key(&addr));
+        assert!(!addr_is_backed_off_at(&backoff, &addr, now));
+        assert_eq!(
+            next_addr_dial_backoff(backoff.get(&addr), now).failures,
+            5
+        );
+    }
+
+    #[test]
+    fn stale_failure_history_is_pruned_and_success_clears_state() {
+        let now = Instant::now();
+        let addr = test_addr();
+        let mut backoff = HashMap::from([(
+            addr.clone(),
+            AddrDialBackoff {
+                failures: 6,
+                retry_at: now - Duration::from_secs(1),
+                last_failure_at: now
+                    - Duration::from_secs(ADDR_BACKOFF_RETENTION_SECS + 1),
+            },
+        )]);
+
+        prune_addr_backoff_at(&mut backoff, now);
+        assert!(!backoff.contains_key(&addr));
+
+        backoff.insert(addr.clone(), next_addr_dial_backoff(None, now));
+        note_addr_dial_success(&mut backoff, &addr);
+        assert!(!backoff.contains_key(&addr));
+    }
+
+    #[test]
+    fn only_expected_transport_failures_are_compacted() {
+        assert_eq!(
+            expected_dial_failure_reason("Os { kind: TimedOut }"),
+            Some("timeout")
+        );
+        assert_eq!(
+            expected_dial_failure_reason("DialError::ConnectionRefused"),
+            Some("connection_refused")
+        );
+        assert_eq!(
+            expected_dial_failure_reason("WrongPeerId { obtained: ... }"),
+            None
+        );
+        assert_eq!(expected_dial_failure_reason("kind: InvalidData"), None);
+    }
+
+    #[test]
+    fn pending_address_blocks_duplicate_dials_until_consumed() {
+        let peer: PeerId =
+            "12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+                .parse()
+                .unwrap();
+        let addr = test_addr();
+        let mut pending = HashMap::new();
+
+        assert!(!addr_dial_is_pending(&pending, &peer, &addr));
+        note_pending_dial(&mut pending, peer, addr.clone());
+        assert!(addr_dial_is_pending(&pending, &peer, &addr));
+        assert_eq!(take_pending_dials(&mut pending, &peer), vec![addr.clone()]);
+        assert!(!addr_dial_is_pending(&pending, &peer, &addr));
+    }
+}
