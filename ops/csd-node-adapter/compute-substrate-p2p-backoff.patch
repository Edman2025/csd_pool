+fn next_addr_dial_backoff(
+    previous: Option<&AddrDialBackoff>,
+    now: Instant,
+) -> AddrDialBackoff {
+    let failures = previous
+        .map(|state| state.failures.saturating_add(1))
+        .unwrap_or(1);
+    AddrDialBackoff {
+        failures,
+        retry_at: now + Duration::from_secs(addr_backoff_secs(failures)),
+        last_failure_at: now,
+    }
+}
