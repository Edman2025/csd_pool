-        .map(|(_, until)| Instant::now() < *until)
+        .map(|state| now < state.retry_at)
         .unwrap_or(false)
+}
+
+fn addr_is_backed_off(
+    addr_backoff: &HashMap<Multiaddr, AddrDialBackoff>,
+    addr: &Multiaddr,
+) -> bool {
+    addr_is_backed_off_at(addr_backoff, addr, Instant::now())
