+fn pool_api_auth(headers: &HeaderMap) -> Result<(), PoolApiError> {
+    let expected = std::env::var("CSD_POOL_ADAPTER_TOKEN").unwrap_or_default();
+    if expected.len() < 32 {
+        return Err((
+            StatusCode::SERVICE_UNAVAILABLE,
+            Json(serde_json::json!({"ok": false, "error": "pool adapter token is not configured"})),
+        ));
+    }
+    let actual = headers
+        .get(axum::http::header::AUTHORIZATION)
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.strip_prefix("Bearer "))
+        .unwrap_or_default();
+    let left = actual.as_bytes();
+    let right = expected.as_bytes();
+    let mut diff = left.len() ^ right.len();
+    for index in 0..left.len().max(right.len()) {
+        diff |= usize::from(*left.get(index).unwrap_or(&0) ^ *right.get(index).unwrap_or(&0));
+    }
+    if diff != 0 {
+        return Err((
+            StatusCode::UNAUTHORIZED,
+            Json(serde_json::json!({"ok": false, "error": "invalid pool adapter token"})),
+        ));
+    }
+    Ok(())
+}
+
+fn pool_api_error(status: StatusCode, error: impl ToString) -> PoolApiError {
+    (
+        status,
+        Json(serde_json::json!({"ok": false, "error": error.to_string()})),
+    )
+}
+
+fn pool_merkle_branch(txids: &[Hash32]) -> Vec<Hash32> {
+    if txids.len() <= 1 {
+        return Vec::new();
+    }
+    let mut branch = Vec::new();
+    let mut layer = txids.to_vec();
+    while layer.len() > 1 {
+        let sibling = layer.get(1).copied().unwrap_or(layer[0]);
+        branch.push(sibling);
+        let mut next = Vec::with_capacity((layer.len() + 1) / 2);
+        for pair in layer.chunks(2) {
+            let left = pair[0];
+            let right = pair.get(1).copied().unwrap_or(left);
+            let mut bytes = [0u8; 64];
+            bytes[..32].copy_from_slice(&left);
+            bytes[32..].copy_from_slice(&right);
+            next.push(crate::crypto::sha256d(&bytes));
+        }
+        layer = next;
+    }
+    branch
+}
