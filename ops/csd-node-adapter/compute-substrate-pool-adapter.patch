+    #[tokio::test]
+    async fn signed_receipt_path_recovers_after_observer_disconnect() {
+        let mut publisher = actual_gossipsub_swarm();
+        let mut observer = actual_gossipsub_swarm();
+        let publisher_peer = *publisher.local_peer_id();
+        let observer_peer = *observer.local_peer_id();
+        publisher.listen_on("/memory/0".parse().unwrap()).unwrap();
+        let listen_addr = tokio::time::timeout(Duration::from_secs(2), async {
+            loop {
+                if let SwarmEvent::NewListenAddr { address, .. } =
+                    publisher.select_next_some().await
+                {
+                    break address;
+                }
+            }
+        })
+        .await
+        .expect("publisher must start listening");
+        observer
+            .dial(listen_addr.clone().with(libp2p::multiaddr::Protocol::P2p(
+                publisher_peer,
+            )))
+            .unwrap();
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                tokio::select! {
+                    event = publisher.select_next_some() => {
+                        if matches!(event, SwarmEvent::ConnectionEstablished { peer_id, .. }
+                            if peer_id == observer_peer)
+                        {
+                            break;
+                        }
+                    }
+                    _ = observer.select_next_some() => {}
+                }
+            }
+        })
+        .await
+        .expect("observer must connect");
+
+        let _ = publisher.disconnect_peer_id(observer_peer);
+        tokio::time::timeout(Duration::from_secs(3), async {
+            let mut publisher_closed = false;
+            let mut observer_closed = false;
+            while !publisher_closed || !observer_closed {
+                tokio::select! {
+                    event = publisher.select_next_some() => {
+                        publisher_closed |= matches!(
+                            event,
+                            SwarmEvent::ConnectionClosed { peer_id, .. }
+                                if peer_id == observer_peer
+                        );
+                    }
+                    event = observer.select_next_some() => {
+                        observer_closed |= matches!(
+                            event,
+                            SwarmEvent::ConnectionClosed { peer_id, .. }
+                                if peer_id == publisher_peer
+                        );
+                    }
+                }
+            }
+        })
+        .await
+        .expect("both peers must observe the disconnect");
+
+        observer
+            .dial(listen_addr.with(libp2p::multiaddr::Protocol::P2p(
+                publisher_peer,
+            )))
+            .unwrap();
+        tokio::time::timeout(Duration::from_secs(3), async {
+            let mut observer_header_subscription = false;
+            let mut publisher_ack_subscription = false;
+            while !observer_header_subscription || !publisher_ack_subscription {
+                tokio::select! {
+                    event = publisher.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Subscribed { peer_id, topic }
+                        )) = event {
+                            observer_header_subscription |=
+                                peer_id == observer_peer && topic.as_str() == TOPIC_HDR;
+                        }
+                    }
+                    event = observer.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Subscribed { peer_id, topic }
+                        )) = event {
+                            publisher_ack_subscription |=
+                                peer_id == publisher_peer && topic.as_str() == TOPIC_HDR_ACK;
+                        }
+                    }
+                }
+            }
+        })
+        .await
+        .expect("receipt topics must resubscribe after reconnect");
+
+        let header = BlockHeader {
+            version: 1,
+            prev: [0x51; 32],
+            merkle: [0x52; 32],
+            time: 1_700_000_002,
+            bits: 0x207f_ffff,
+            nonce: 44,
+        };
+        let hash = header_hash(&header);
+        let receipts = HeaderRelayReceipts::default();
+        receipts.note_published(hash, 2_000);
+        assert!(publish_header(&mut publisher, header).ok);
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            let mut receipt_sent = false;
+            while !receipt_sent {
+                tokio::select! {
+                    _ = publisher.select_next_some() => {}
+                    event = observer.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Message { message, .. }
+                        )) = event {
+                            if message.topic.as_str() == TOPIC_HDR {
+                                let encoded = encode_header_receipt_ack(&GossipHeaderReceiptAck {
+                                    genesis_hash: [0x54; 32],
+                                    header_hash: hash,
+                                    received_unix_ms: 2_010,
+                                }).unwrap();
+                                observer.behaviour_mut().gossipsub
+                                    .publish(IdentTopic::new(TOPIC_HDR_ACK), encoded)
+                                    .expect("observer receipt publish after reconnect");
+                                receipt_sent = true;
+                            }
+                        }
+                    }
+                }
+            }
+        })
+        .await
+        .expect("observer must receive the header after reconnect");
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                tokio::select! {
+                    event = publisher.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Message { message, .. }
+                        )) = event {
+                            if message.topic.as_str() == TOPIC_HDR_ACK {
+                                assert_eq!(message.source, Some(observer_peer));
+                                let receipt = decode_header_receipt_ack(&message.data).unwrap();
+                                assert!(receipts.note_remote_ack(
+                                    receipt.header_hash,
+                                    observer_peer.to_string(),
+                                    2_012,
