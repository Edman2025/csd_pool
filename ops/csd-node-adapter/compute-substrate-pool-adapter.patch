+        let hash = [0x21; 32];
+        let genesis = [0x22; 32];
+        let local = PeerId::random();
+        let remote = PeerId::random();
+        receipts.note_published(hash, 1_000);
+        let receipt = GossipHeaderReceiptAck {
+            genesis_hash: genesis,
+            header_hash: hash,
+            received_unix_ms: 1_005,
+        };
+        assert!(!record_signed_header_receipt(
+            &receipts,
+            [0xff; 32],
+            local,
+            Some(remote),
+            receipt.clone(),
+            1_010,
+        ));
+        assert!(!record_signed_header_receipt(
+            &receipts,
+            genesis,
+            local,
+            None,
+            receipt.clone(),
+            1_010,
+        ));
+        assert!(!record_signed_header_receipt(
+            &receipts,
+            genesis,
+            local,
+            Some(local),
+            receipt.clone(),
+            1_010,
+        ));
+        let unknown = GossipHeaderReceiptAck {
+            header_hash: [0x23; 32],
+            ..receipt
+        };
+        assert!(!record_signed_header_receipt(
+            &receipts,
+            genesis,
+            local,
+            Some(remote),
+            unknown,
+            1_010,
+        ));
+        assert_eq!(receipts.snapshot(&hash).unwrap().remote_ack_count, 0);
+    }
