+    distinct_peer_count_saturated: bool,
+    payload_prepared: u64,
+    payload_enqueued: u64,
+    payload_write_complete: u64,
+    negative_responses: u64,
+    timeouts: u64,
+    transport_failures: u64,
+    abnormal: u64,
+    telemetry_drops: u64,
+    outstanding: u64,
+    first_request_latency_us: Option<u64>,
+    first_write_complete_latency_us: Option<u64>,
+}
+
+#[derive(Default)]
+struct AggregateEvidence {
+    candidates_registered: u64,
+    candidates_evicted: u64,
+    announce_enqueued: u64,
+    announce_publish_complete: u64,
+    announce_publish_failed: u64,
+    external_requests: u64,
+    payload_prepared: u64,
+    payload_enqueued: u64,
+    payload_write_complete: u64,
+    negative_responses: u64,
+    timeouts: u64,
+    transport_failures: u64,
+    abnormal: u64,
+    telemetry_drops: u64,
+    unknown_block_requests: u64,
+}
+
+#[derive(Default)]
+struct EvidenceInner {
+    next_generation: u64,
+    candidates: HashMap<BlindKey, CandidateEvidence>,
+    order: VecDeque<BlindKey>,
+    pending: HashMap<String, PendingRequest>,
+    aggregate: AggregateEvidence,
+}
+
+pub struct FullBlockDeliveryEvidence {
+    salt: [u8; 32],
+    inner: Mutex<EvidenceInner>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct FullBlockCandidateEvidenceSnapshot {
+    pub protocol_version: u32,
+    pub evidence_semantics: &'static str,
