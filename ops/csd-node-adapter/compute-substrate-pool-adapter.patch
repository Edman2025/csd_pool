+    pub payload_prepared: u64,
+    pub payload_enqueued: u64,
+    pub payload_write_complete: u64,
+    pub negative_responses: u64,
+    pub timeouts: u64,
+    pub transport_failures: u64,
+    pub abnormal: u64,
+    pub telemetry_drops: u64,
+    pub outstanding_requests: u64,
+    pub terminal_total: u64,
+    pub conservation_ok: bool,
+    pub first_request_latency_us: Option<u64>,
+    pub first_write_complete_latency_us: Option<u64>,
