+async fn pool_block_submit(
+    headers: HeaderMap,
+    State(st): State<ApiState>,
+    Json(request): Json<PoolCandidateReq>,
+) -> Result<Json<PoolBlockResp>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let request_started = Instant::now();
+    let request_received_unix_ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(u64::MAX);
+    let job = st
+        .pool_jobs
+        .read()
+        .map_err(|_| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, "pool job cache poisoned"))?
+        .get(&request.job_id)
+        .cloned()
+        .ok_or_else(|| pool_api_error(StatusCode::CONFLICT, "stale or unknown pool job"))?;
+    let block = assemble_pool_block(job.block, &job.coinb1, &job.coinb2, &request)?;
+    apply_pool_block(&st, block, request_started, request_received_unix_ms).await
+}
+
+async fn pool_block_submit_full(
+    headers: HeaderMap,
+    State(st): State<ApiState>,
+    Json(request): Json<PoolFullCandidateReq>,
+) -> Result<Json<PoolBlockResp>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let request_started = Instant::now();
+    let request_received_unix_ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(u64::MAX);
+    let encoded = normalized_hash(&request.block_template_hex);
+    if encoded.len() > MAX_STATELESS_TEMPLATE_HEX_LEN || encoded.len() % 2 != 0 {
+        return Err(pool_api_error(
+            StatusCode::PAYLOAD_TOO_LARGE,
+            "block_template_hex exceeds the encoded consensus limit or has odd length",
+        ));
+    }
+    let template_bytes = hex::decode(encoded)
+        .map_err(|_| pool_api_error(StatusCode::BAD_REQUEST, "block_template_hex is invalid"))?;
+    if template_bytes.len() > crate::params::MAX_BLOCK_BYTES
+        || request.block_template_bytes != template_bytes.len() as u64
+    {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block template byte length mismatch",
+        ));
+    }
+    let digest = hex::encode(Sha256::digest(&template_bytes));
+    if !digest.eq_ignore_ascii_case(normalized_hash(
+        &request.block_template_sha256_hex,
+    )) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block template sha256 mismatch",
+        ));
+    }
+    let template: Block = c().deserialize(&template_bytes).map_err(|error| {
+        pool_api_error(
+            StatusCode::BAD_REQUEST,
+            format!("block template decode failed: {error}"),
+        )
+    })?;
+    if c().serialize(&template).ok().as_deref() != Some(template_bytes.as_slice()) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block template encoding is not canonical",
+        ));
+    }
+    if !hex::encode(header_hash(&template.header))
+        .eq_ignore_ascii_case(normalized_hash(&request.candidate.job_id))
+    {
+        return Err(pool_api_error(
+            StatusCode::CONFLICT,
+            "job_id does not bind the canonical block template",
+        ));
+    }
+    let template_coinbase = template.txs.first().ok_or_else(|| {
+        pool_api_error(StatusCode::BAD_REQUEST, "block template has no coinbase")
+    })?;
+    let template_coinbase_bytes = c()
+        .serialize(template_coinbase)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let positions = template_coinbase_bytes
+        .windows(POOL_EXTRANONCE_PLACEHOLDER.len())
+        .enumerate()
+        .filter_map(|(index, bytes)| {
+            (bytes == POOL_EXTRANONCE_PLACEHOLDER).then_some(index)
+        })
+        .collect::<Vec<_>>();
+    if positions.len() != 1 {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block template coinbase placeholder is not unique",
+        ));
+    }
+    let split = positions[0];
+    let coinb1 = &template_coinbase_bytes[..split];
+    let coinb2 = &template_coinbase_bytes[split + POOL_EXTRANONCE_PLACEHOLDER.len()..];
+    let block = assemble_pool_block(template, coinb1, coinb2, &request.candidate)?;
+    apply_pool_block(&st, block, request_started, request_received_unix_ms).await
+}
+
+fn assemble_pool_block(
+    mut block: Block,
+    coinb1: &[u8],
+    coinb2: &[u8],
+    request: &PoolCandidateReq,
+) -> Result<Block, PoolApiError> {
+    let coinbase_bytes = hex::decode(normalized_hash(&request.coinbase_hex))
+        .map_err(|_| pool_api_error(StatusCode::BAD_REQUEST, "coinbase_hex is invalid"))?;
+    if coinbase_bytes.len() != coinb1.len() + 8 + coinb2.len()
+        || !coinbase_bytes.starts_with(coinb1)
+        || !coinbase_bytes.ends_with(coinb2)
+    {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase does not match pool job",
+        ));
+    }
+    let coinbase: Transaction = c().deserialize(&coinbase_bytes).map_err(|error| {
+        pool_api_error(
+            StatusCode::BAD_REQUEST,
+            format!("coinbase decode failed: {error}"),
+        )
+    })?;
+    if c().serialize(&coinbase).ok().as_deref() != Some(coinbase_bytes.as_slice()) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase encoding is not canonical",
+        ));
+    }
+    if !hex::encode(txid(&coinbase))
+        .eq_ignore_ascii_case(normalized_hash(&request.coinbase_txid_hex))
+    {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase txid mismatch",
+        ));
+    }
+    let header = decode_pool_header(&request.header_hex)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    if header.version != block.header.version
+        || header.prev != block.header.prev
+        || header.time != block.header.time
+        || header.bits != block.header.bits
+    {
+        return Err(pool_api_error(
+            StatusCode::CONFLICT,
+            "header fixed fields do not match pool job",
+        ));
+    }
+    let Some(first) = block.txs.first_mut() else {
+        return Err(pool_api_error(StatusCode::BAD_REQUEST, "pool job has no coinbase"));
+    };
+    *first = coinbase;
+    block.header = header;
+    if block.header.merkle != crate::chain::mine::merkle_root(&block.txs) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block merkle root mismatch",
+        ));
+    }
+    let hash = header_hash(&block.header);
+    if !hex::encode(hash).eq_ignore_ascii_case(normalized_hash(&request.hash_hex)) {
+        return Err(pool_api_error(StatusCode::BAD_REQUEST, "block hash mismatch"));
+    }
+    if !pow_ok(&hash, block.header.bits) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block proof of work failed",
+        ));
+    }
+    Ok(block)
+}
