+async fn pool_block_submit(
+    headers: HeaderMap,
+    State(st): State<ApiState>,
+    Json(request): Json<PoolCandidateReq>,
+) -> Result<Json<PoolBlockResp>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let job = st
+        .pool_jobs
+        .read()
+        .map_err(|_| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, "pool job cache poisoned"))?
+        .get(&request.job_id)
+        .cloned()
+        .ok_or_else(|| pool_api_error(StatusCode::CONFLICT, "stale or unknown pool job"))?;
+    let coinbase_bytes = hex::decode(normalized_hash(&request.coinbase_hex))
+        .map_err(|_| pool_api_error(StatusCode::BAD_REQUEST, "coinbase_hex is invalid"))?;
+    if coinbase_bytes.len() != job.coinb1.len() + 8 + job.coinb2.len()
+        || !coinbase_bytes.starts_with(&job.coinb1)
+        || !coinbase_bytes.ends_with(&job.coinb2)
+    {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase does not match pool job",
+        ));
+    }
+    let coinbase: Transaction = c().deserialize(&coinbase_bytes).map_err(|error| {
+        pool_api_error(
+            StatusCode::BAD_REQUEST,
+            format!("coinbase decode failed: {error}"),
+        )
+    })?;
+    if c().serialize(&coinbase).ok().as_deref() != Some(coinbase_bytes.as_slice()) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase encoding is not canonical",
+        ));
+    }
+    let coinbase_txid = txid(&coinbase);
+    if !hex::encode(coinbase_txid).eq_ignore_ascii_case(normalized_hash(&request.coinbase_txid_hex))
+    {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase txid mismatch",
+        ));
+    }
+    let header = decode_pool_header(&request.header_hex)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    if header.version != job.block.header.version
+        || header.prev != job.block.header.prev
+        || header.time != job.block.header.time
+        || header.bits != job.block.header.bits
+    {
+        return Err(pool_api_error(
+            StatusCode::CONFLICT,
+            "header fixed fields do not match pool job",
+        ));
+    }
+    let mut block = job.block.clone();
+    block.txs[0] = coinbase;
+    block.header = header;
+    let merkle = crate::chain::mine::merkle_root(&block.txs);
+    if block.header.merkle != merkle {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block merkle root mismatch",
+        ));
+    }
+    let hash = header_hash(&block.header);
+    if !hex::encode(hash).eq_ignore_ascii_case(normalized_hash(&request.hash_hex)) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block hash mismatch",
+        ));
+    }
+    if !pow_ok(&hash, block.header.bits) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block proof of work failed",
+        ));
+    }
+
+    let _guard = st.chain_lock.lock();
+    let current_tip = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        .unwrap_or([0u8; 32]);
+    if current_tip != block.header.prev {
+        return Err(pool_api_error(
+            StatusCode::CONFLICT,
+            "solved pool job is stale",
+        ));
+    }
+    let parent_hi = if current_tip == [0u8; 32] {
+        None
+    } else {
+        get_hidx(&st.db, &current_tip)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+    };
+    let bytes = c()
+        .serialize(&block)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    if bytes.len() > crate::params::MAX_BLOCK_BYTES {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block exceeds consensus size limit",
+        ));
+    }
+    st.db
+        .blocks
+        .insert(k_block(&hash), bytes)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    index_header(&st.db, &block.header, parent_hi.as_ref())
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    maybe_reorg_to(&st.db, &hash, Some(&st.mempool))
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let accepted = get_tip(&st.db).ok().flatten() == Some(hash);
+    if accepted {
+        st.mempool.remove_mined_block(&block);
+        let _ = st.mined_headers.send(crate::net::MinedHeaderEvent {
+            hash,
+            header: block.header.clone(),
+        });
+    }
+    Ok(Json(PoolBlockResp {
+        ok: accepted,
+        hash: Some(hex::encode(hash)),
+        status: if accepted { "accepted" } else { "orphaned" }.to_string(),
+        error: (!accepted).then(|| "block was not selected as canonical tip".to_string()),
+    }))
+}
+
+async fn pool_block_status(
+    headers: HeaderMap,
+    Query(query): Query<PoolBlockStatusQuery>,
+    State(st): State<ApiState>,
+) -> Result<Json<serde_json::Value>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let wanted = parse_hash32(&query.hash)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let indexed = get_hidx(&st.db, &wanted)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    let tip = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        .unwrap_or([0u8; 32]);
+    let tip_hi = get_hidx(&st.db, &tip)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    let mut cursor = tip;
+    let mut canonical = false;
+    while cursor != [0u8; 32] {
+        if cursor == wanted {
+            canonical = true;
+            break;
+        }
+        let Some(header) = get_hidx(&st.db, &cursor)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        else {
+            break;
+        };
+        cursor = header.parent;
+    }
+    let confirmations = if canonical {
+        match (tip_hi.as_ref(), indexed.as_ref()) {
+            (Some(tip), Some(block)) => tip.height.saturating_sub(block.height).saturating_add(1),
+            _ => 0,
+        }
+    } else {
+        0
+    };
+    let reward = st
+        .db
+        .blocks
+        .get(k_block(&wanted))
+        .ok()
+        .flatten()
+        .and_then(|bytes| c().deserialize::<Block>(&bytes).ok())
+        .and_then(|block| {
+            block
+                .txs
+                .first()
+                .and_then(|tx| tx.outputs.first())
+                .map(|output| output.value)
+        });
+    let status = if canonical {
+        "seen_on_chain"
+    } else if indexed.is_some() {
+        "orphaned"
+    } else {
+        "submitted"
+    };
+    Ok(Json(serde_json::json!({
+        "hash": hex::encode(wanted),
+        "status": status,
+        "height": indexed.map(|header| header.height),
+        "confirmations": confirmations,
+        "reward_base_units": reward,
+        "template_height": st.pool_jobs.read().ok().and_then(|jobs| jobs.values().next().map(|job| job.height)),
+    })))
+}
