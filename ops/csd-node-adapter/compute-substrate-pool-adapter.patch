+                                break;
+                            }
+                        }
+                    }
+                    _ = observer.select_next_some() => {}
+                }
+            }
+        })
+        .await
+        .expect("publisher must receive a signed receipt after reconnect");
+
+        assert_eq!(receipts.snapshot(&hash).unwrap().remote_ack_count, 1);
+    }
