+#[cfg(test)]
+mod fast_tip_cli_tests {
+    use super::*;
+
+    #[test]
+    fn env_absent_defaults_to_disabled() {
+        assert!(!fast_tip_recheck_enabled_value(false, None));
+    }
+
+    #[test]
+    fn env_false_values_stay_disabled() {
+        for value in ["", "0", "false", "no", "off", "unexpected"] {
+            assert!(!fast_tip_recheck_enabled_value(false, Some(value)), "{value}");
+        }
+    }
+
+    #[test]
+    fn env_true_values_enable_fast_tip() {
+        for value in ["1", "true", "yes", "on", " TRUE "] {
+            assert!(fast_tip_recheck_enabled_value(false, Some(value)), "{value}");
+        }
+    }
+
+    #[test]
+    fn cli_true_enables_fast_tip_without_env() {
+        let parsed = Cmd::try_parse_from(["csd", "node", "--fast-tip-recheck-on-gossip"])
+            .expect("node command parses");
+        let Commands::Node {
+            fast_tip_recheck_on_gossip,
+            ..
+        } = parsed.cmd
+        else {
+            panic!("expected node command");
+        };
+        assert!(fast_tip_recheck_on_gossip);
+        assert!(fast_tip_recheck_enabled_value(
+            fast_tip_recheck_on_gossip,
+            None
+        ));
+    }
+
+    #[test]
+    fn node_help_exposes_fast_tip_flag() {
+        let help = match Cmd::try_parse_from(["csd", "node", "--help"]) {
+            Ok(_) => panic!("help must exit through clap"),
+            Err(error) => error.to_string(),
+        };
+        assert!(help.contains("--fast-tip-recheck-on-gossip"));
+    }
+
+    #[test]
+    fn receipt_observer_is_disabled_when_env_is_absent_or_empty() {
+        assert_eq!(header_receipt_observer_peer_value(None).unwrap(), None);
+        assert_eq!(
+            header_receipt_observer_peer_value(Some("   ")).unwrap(),
+            None
+        );
+    }
+
+    #[test]
+    fn receipt_observer_accepts_exact_peer_id() {
+        let peer = libp2p::PeerId::from(
+            libp2p::identity::Keypair::generate_ed25519().public(),
+        );
+        assert_eq!(
+            header_receipt_observer_peer_value(Some(&peer.to_string())).unwrap(),
+            Some(peer)
+        );
+    }
+
+    #[test]
+    fn receipt_observer_rejects_malformed_value_without_echoing_it() {
+        let error = header_receipt_observer_peer_value(Some("not-a-peer")).unwrap_err();
+        assert_eq!(
+            error.to_string(),
+            "invalid CSD_HEADER_RECEIPT_OBSERVER_PEER"
+        );
+    }
+}
