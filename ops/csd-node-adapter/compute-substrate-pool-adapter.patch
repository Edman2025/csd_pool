+        );
+        assert_eq!(
+            expected_dial_failure_reason("WrongPeerId { obtained: ... }"),
+            None
+        );
+        assert_eq!(expected_dial_failure_reason("kind: InvalidData"), None);
+    }
+
+    #[test]
+    fn pending_address_blocks_duplicate_dials_until_consumed() {
+        let peer: PeerId = "12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+            .parse()
+            .unwrap();
+        let addr = test_addr();
+        let mut pending = HashMap::new();
+
+        assert!(!addr_dial_is_pending(&pending, &peer, &addr));
+        note_pending_dial(&mut pending, peer, addr.clone());
+        assert!(addr_dial_is_pending(&pending, &peer, &addr));
+        assert_eq!(take_pending_dials(&mut pending, &peer), vec![addr.clone()]);
+        assert!(!addr_dial_is_pending(&pending, &peer, &addr));
+    }
+
+    #[test]
+    fn successful_dial_submission_creates_pending_state() {
+        let peer: PeerId = "12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+            .parse()
+            .unwrap();
+        let addr = test_addr();
+        let mut pending = HashMap::new();
+        let mut backoff = HashMap::new();
+
+        assert!(record_dial_submission::<&'static str>(
+            Ok(()),
+            &mut pending,
+            &mut backoff,
+            Some(peer),
+            &addr,
+        ));
+        assert!(addr_dial_is_pending(&pending, &peer, &addr));
+        assert!(!backoff.contains_key(&addr));
+    }
+
+    #[test]
+    fn synchronous_dial_failure_enters_backoff_without_pending_state() {
+        let peer: PeerId = "12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+            .parse()
+            .unwrap();
+        let addr = test_addr();
+        let mut pending = HashMap::new();
+        let mut backoff = HashMap::new();
+
+        assert!(!record_dial_submission(
+            Err("NoAddresses"),
+            &mut pending,
+            &mut backoff,
+            Some(peer),
+            &addr,
+        ));
+        assert!(!addr_dial_is_pending(&pending, &peer, &addr));
+        assert_eq!(backoff.get(&addr).map(|state| state.failures), Some(1));
+    }
+
+    #[test]
+    fn expired_pending_dial_does_not_block_retry() {
+        let peer: PeerId = "12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+            .parse()
+            .unwrap();
+        let addr = test_addr();
+        let now = Instant::now();
+        let mut pending = HashMap::new();
+
+        note_pending_dial_at(
+            &mut pending,
+            peer,
+            addr.clone(),
+            now - Duration::from_secs(PENDING_DIAL_RETENTION_SECS + 1),
+        );
+
+        assert!(!addr_dial_is_pending_at(&pending, &peer, &addr, now));
+    }
+
+    #[test]
+    fn peer_id_suffix_is_removed_for_exact_transport_address_tracking() {
+        let with_peer: Multiaddr =
+            "/ip4/127.0.0.1/tcp/17999/p2p/12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+                .parse()
+                .unwrap();
+        let expected: Multiaddr = "/ip4/127.0.0.1/tcp/17999".parse().unwrap();
+        assert_eq!(transport_addr_without_peer_id(&with_peer), expected);
+    }
+
+    #[test]
+    fn exact_loopback_tracking_is_address_specific_not_peer_wide() {
+        let peer: PeerId = "12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+            .parse()
+            .unwrap();
+        let loopback: Multiaddr =
+            "/ip4/127.0.0.1/tcp/17999/p2p/12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+                .parse()
+                .unwrap();
+        let public: Multiaddr = "/ip4/203.0.113.10/tcp/17999".parse().unwrap();
+        let mut active = HashMap::new();
+        active.insert((peer, public), 1usize);
+
+        assert!(multiaddr_is_loopback(&loopback));
+        assert!(!exact_dial_addr_connected(&active, peer, &loopback));
+
+        active.insert((peer, transport_addr_without_peer_id(&loopback)), 1usize);
+        assert!(exact_dial_addr_connected(&active, peer, &loopback));
+    }
+
+    #[test]
+    fn expired_exact_loopback_pending_does_not_block_redial() {
+        let peer: PeerId = "12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+            .parse()
+            .unwrap();
+        let loopback: Multiaddr =
+            "/ip4/127.0.0.1/tcp/17999/p2p/12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+                .parse()
+                .unwrap();
+        let started_at =
+            Instant::now() - Duration::from_secs(PENDING_DIAL_RETENTION_SECS + 1);
+        let now = Instant::now();
+        let connection_id = ConnectionId::new_unchecked(41);
+        let mut pending = HashMap::from([(
+            connection_id,
+            (peer, transport_addr_without_peer_id(&loopback), started_at),
+        )]);
+
+        assert!(!exact_dial_addr_pending_at(
+            &pending,
+            peer,
+            &loopback,
+            now
+        ));
+        prune_exact_loopback_pending_at(&mut pending, now);
+        assert!(pending.is_empty());
+    }
+
+    #[test]
+    fn exact_terminal_event_does_not_consume_generic_pending_for_same_peer() {
+        let peer: PeerId = "12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+            .parse()
+            .unwrap();
+        let public: Multiaddr =
+            "/ip4/203.0.113.10/tcp/17999/p2p/12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+                .parse()
+                .unwrap();
+        let loopback: Multiaddr =
+            "/ip4/127.0.0.1/tcp/17999/p2p/12D3KooWFsHa5ifqK45Fjd8cYnDkVDN8R8MfjfiETNpEqnbGAEez"
+                .parse()
+                .unwrap();
+        let connection_id = ConnectionId::new_unchecked(42);
+        let mut generic = HashMap::new();
+        note_pending_dial(&mut generic, peer, public.clone());
+        let mut exact = HashMap::from([(
+            connection_id,
+            (
+                peer,
+                transport_addr_without_peer_id(&loopback),
+                Instant::now(),
+            ),
+        )]);
+
+        assert!(exact.remove(&connection_id).is_some());
+        assert!(addr_dial_is_pending(&generic, &peer, &public));
+    }
+}
