+/// Choose a consensus-valid Stratum template time without blocking the RPC task.
+///
+/// The regular miner waits for wall clock so LWMA follows elapsed time. A pool
+/// template cannot wait while retaining an old parent because the network tip
+/// may advance before the response is returned.
+pub(crate) fn choose_pool_block_time(
+    db: &Stores,
+    parent_tip: &Hash32,
+    parent_hi: Option<&HeaderIndex>,
+) -> Result<u64> {
+    if *parent_tip == [0u8; 32] || parent_hi.is_none() {
+        return Ok(0);
+    }
+
+    let parent = parent_hi.unwrap();
+    let mtp = median_time_past(db, &parent.hash)?;
+    let min_ok = parent
+        .time
+        .saturating_add(MIN_BLOCK_SPACING_SECS)
+        .max(mtp.saturating_add(1));
+    let now = now_secs();
+    let time = now.max(min_ok);
+    let max_allowed = now.saturating_add(MAX_FUTURE_DRIFT_SECS);
+    if time > max_allowed {
+        return Err(anyhow!(
+            "pool block time exceeds future drift: {} > {}",
+            time,
+            max_allowed
+        ));
+    }
+
+    Ok(time)
+}
