--- /dev/null
+++ b/src/net/receipt.rs
@@ -0,0 +1,1196 @@
+use std::{
+    collections::{HashMap, VecDeque},
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        Arc,
+    },
+    time::{Duration, Instant},
+};
+
+use libp2p::{gossipsub::MessageId, identity, request_response::OutboundRequestId, PeerId};
+use rand::RngCore;
+use rand::SeedableRng;
+use rand_chacha::ChaCha20Rng;
+use serde::Serialize;
+
+use super::proto::{ReceiptRequest, ReceiptResponse};
+
+const RECEIPT_DOMAIN: &[u8] = b"csd/header-receipt/v2";
+const SEEN_TTL: Duration = Duration::from_secs(10);
+const PENDING_TTL: Duration = Duration::from_secs(2);
+pub(crate) const RECEIPT_PROBE_DELAY: Duration = Duration::from_millis(100);
+pub(crate) const RECEIPT_OBSERVER_GRACE: Duration = Duration::from_millis(400);
+const MAX_SEEN_MESSAGES: usize = 256;
+const MAX_PENDING_RECEIPTS: usize = 256;
+pub(crate) const MAX_DEFERRED_RECEIPTS: usize = 16;
+const MAX_PUBLIC_KEY_BYTES: usize = 128;
+const MAX_SIGNATURE_BYTES: usize = 128;
+const SERVE_RATE_WINDOW: Duration = Duration::from_secs(10);
+const MAX_PROBES_PER_SERVE_WINDOW: u32 = 16;
+
+#[derive(Default)]
+pub struct ReceiptMetrics {
+    configured: AtomicBool,
+    probes_scheduled: AtomicU64,
+    probes_enqueued: AtomicU64,
+    probes_skipped_disconnected: AtomicU64,
+    probes_dropped_capacity: AtomicU64,
+    observer_probes_served: AtomicU64,
+    observer_seen: AtomicU64,
+    observer_unseen: AtomicU64,
+    observer_rate_limited: AtomicU64,
+    observer_deferred: AtomicU64,
+    observer_grace_seen: AtomicU64,
+    observer_grace_expired_unseen: AtomicU64,
+    observer_deferred_dropped_capacity: AtomicU64,
+    observer_signal_received: AtomicU64,
+    observer_gossip_seen: AtomicU64,
+    observer_local_duplicate: AtomicU64,
+    remote_seen: AtomicU64,
+    remote_unseen: AtomicU64,
+    remote_signal_seen: AtomicU64,
+    remote_gossip_seen: AtomicU64,
+    remote_local_duplicate: AtomicU64,
+    timeouts: AtomicU64,
+    transport_failures: AtomicU64,
+    malformed_responses: AtomicU64,
+    bad_signatures: AtomicU64,
+    peer_mismatches: AtomicU64,
+    unmatched_responses: AtomicU64,
+    latency_le_100ms: AtomicU64,
+    latency_le_500ms: AtomicU64,
+    latency_le_2000ms: AtomicU64,
+    latency_gt_2000ms: AtomicU64,
+}
+
+#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
+pub struct ReceiptMetricsSnapshot {
+    pub protocol_version: u8,
+    pub remote_seen_semantics: &'static str,
+    pub remote_signal_seen_semantics: &'static str,
+    pub configured: bool,
+    pub probes_scheduled: u64,
+    pub probes_enqueued: u64,
+    pub probes_skipped_disconnected: u64,
+    pub probes_dropped_capacity: u64,
+    pub observer_probes_served: u64,
+    pub observer_seen: u64,
+    pub observer_unseen: u64,
+    pub observer_rate_limited: u64,
+    pub observer_deferred: u64,
+    pub observer_grace_seen: u64,
+    pub observer_grace_expired_unseen: u64,
+    pub observer_deferred_dropped_capacity: u64,
+    pub observer_signal_received: u64,
+    pub observer_gossip_seen: u64,
+    pub observer_local_duplicate: u64,
+    pub remote_seen: u64,
+    pub remote_unseen: u64,
+    pub remote_signal_seen: u64,
+    pub remote_gossip_seen: u64,
+    pub remote_local_duplicate: u64,
+    pub timeouts: u64,
+    pub transport_failures: u64,
+    pub malformed_responses: u64,
+    pub bad_signatures: u64,
+    pub peer_mismatches: u64,
+    pub unmatched_responses: u64,
+    pub latency_le_100ms: u64,
+    pub latency_le_500ms: u64,
+    pub latency_le_2000ms: u64,
+    pub latency_gt_2000ms: u64,
+}
+
+impl ReceiptMetrics {
+    pub fn snapshot(&self) -> ReceiptMetricsSnapshot {
+        ReceiptMetricsSnapshot {
+            protocol_version: 2,
+            remote_seen_semantics: "GOSSIP_HEADER_CALLBACK",
+            remote_signal_seen_semantics: "SIGNED_REMOTE_SIGNAL",
+            configured: self.configured.load(Ordering::Relaxed),
+            probes_scheduled: self.probes_scheduled.load(Ordering::Relaxed),
+            probes_enqueued: self.probes_enqueued.load(Ordering::Relaxed),
+            probes_skipped_disconnected: self.probes_skipped_disconnected.load(Ordering::Relaxed),
+            probes_dropped_capacity: self.probes_dropped_capacity.load(Ordering::Relaxed),
+            observer_probes_served: self.observer_probes_served.load(Ordering::Relaxed),
+            observer_seen: self.observer_seen.load(Ordering::Relaxed),
+            observer_unseen: self.observer_unseen.load(Ordering::Relaxed),
+            observer_rate_limited: self.observer_rate_limited.load(Ordering::Relaxed),
+            observer_deferred: self.observer_deferred.load(Ordering::Relaxed),
+            observer_grace_seen: self.observer_grace_seen.load(Ordering::Relaxed),
+            observer_grace_expired_unseen: self
+                .observer_grace_expired_unseen
+                .load(Ordering::Relaxed),
+            observer_deferred_dropped_capacity: self
+                .observer_deferred_dropped_capacity
+                .load(Ordering::Relaxed),
+            observer_signal_received: self.observer_signal_received.load(Ordering::Relaxed),
+            observer_gossip_seen: self.observer_gossip_seen.load(Ordering::Relaxed),
+            observer_local_duplicate: self.observer_local_duplicate.load(Ordering::Relaxed),
+            remote_seen: self.remote_seen.load(Ordering::Relaxed),
+            remote_unseen: self.remote_unseen.load(Ordering::Relaxed),
+            remote_signal_seen: self.remote_signal_seen.load(Ordering::Relaxed),
+            remote_gossip_seen: self.remote_gossip_seen.load(Ordering::Relaxed),
+            remote_local_duplicate: self.remote_local_duplicate.load(Ordering::Relaxed),
+            timeouts: self.timeouts.load(Ordering::Relaxed),
+            transport_failures: self.transport_failures.load(Ordering::Relaxed),
+            malformed_responses: self.malformed_responses.load(Ordering::Relaxed),
+            bad_signatures: self.bad_signatures.load(Ordering::Relaxed),
+            peer_mismatches: self.peer_mismatches.load(Ordering::Relaxed),
+            unmatched_responses: self.unmatched_responses.load(Ordering::Relaxed),
+            latency_le_100ms: self.latency_le_100ms.load(Ordering::Relaxed),
+            latency_le_500ms: self.latency_le_500ms.load(Ordering::Relaxed),
+            latency_le_2000ms: self.latency_le_2000ms.load(Ordering::Relaxed),
+            latency_gt_2000ms: self.latency_gt_2000ms.load(Ordering::Relaxed),
+        }
+    }
+
+    fn note_latency(&self, elapsed: Duration) {
+        if elapsed <= Duration::from_millis(100) {
+            self.latency_le_100ms.fetch_add(1, Ordering::Relaxed);
+        }
+        if elapsed <= Duration::from_millis(500) {
+            self.latency_le_500ms.fetch_add(1, Ordering::Relaxed);
+        }
+        if elapsed <= Duration::from_millis(2_000) {
+            self.latency_le_2000ms.fetch_add(1, Ordering::Relaxed);
+        } else {
+            self.latency_gt_2000ms.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+}
+
+#[derive(Clone)]
+struct SeenMessage {
+    message_id: Vec<u8>,
+    seen_at: Instant,
+}
+
+struct PendingReceipt {
+    peer: PeerId,
+    correlation_id: [u8; 16],
+    nonce: [u8; 32],
+    blinded_tag: [u8; 32],
+    signal_generation: u64,
+    started_at: Instant,
+}
+
+#[derive(Clone)]
+struct ScheduledProbe {
+    message_id: MessageId,
+    scheduled_at: Instant,
+    due_at: Instant,
+}
+
+pub struct ReceiptState {
+    observer_peer: Option<PeerId>,
+    metrics: Arc<ReceiptMetrics>,
+    seen: VecDeque<SeenMessage>,
+    local_published: VecDeque<SeenMessage>,
+    scheduled: VecDeque<ScheduledProbe>,
+    pending: HashMap<OutboundRequestId, PendingReceipt>,
+    rng: ChaCha20Rng,
+    serve_window_started: Instant,
+    served_in_window: u32,
+    next_signal_generation: u64,
+}
+
+impl ReceiptState {
+    pub fn new(observer_peer: Option<PeerId>, metrics: Arc<ReceiptMetrics>) -> Self {
+        metrics
+            .configured
+            .store(observer_peer.is_some(), Ordering::Relaxed);
+        Self {
+            observer_peer,
+            metrics,
+            seen: VecDeque::with_capacity(MAX_SEEN_MESSAGES),
+            local_published: VecDeque::with_capacity(MAX_SEEN_MESSAGES),
+            scheduled: VecDeque::with_capacity(MAX_PENDING_RECEIPTS),
+            pending: HashMap::new(),
+            rng: ChaCha20Rng::from_entropy(),
+            serve_window_started: Instant::now(),
+            served_in_window: 0,
+            next_signal_generation: 1,
+        }
+    }
+
+    pub fn observer_peer(&self) -> Option<PeerId> {
+        self.observer_peer
+    }
+
+    pub fn is_configured(&self) -> bool {
+        self.observer_peer.is_some()
+    }
+
+    pub fn probe_seen(
+        &mut self,
+        peer: PeerId,
+        request: &ReceiptRequest,
+        now: Instant,
+    ) -> Option<bool> {
+        if self.observer_peer != Some(peer) {
+            return None;
+        }
+        self.prune_seen(now);
+        let ReceiptRequest::Probe {
+            nonce, blinded_tag, ..
+        } = request;
+        Some(self.seen.iter().any(|seen| {
+            let candidate = blinded_tag_for_message(nonce, seen.message_id.as_slice());
+            constant_time_eq(&candidate, blinded_tag)
+        }))
+    }
+
+    pub fn note_probe_deferred(&self) {
+        self.metrics
+            .observer_deferred
+            .fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn note_probe_deferred_dropped(&self) {
+        self.metrics
+            .observer_deferred_dropped_capacity
+            .fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn note_probe_grace_completed(&self, seen: bool) {
+        if seen {
+            self.metrics
+                .observer_grace_seen
+                .fetch_add(1, Ordering::Relaxed);
+        } else {
+            self.metrics
+                .observer_grace_expired_unseen
+                .fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    pub fn note_valid_header(&mut self, message_id: &MessageId, now: Instant) {
+        if self.observer_peer.is_none() {
+            return;
+        }
+        self.prune_seen(now);
+        if self
+            .seen
+            .iter()
+            .any(|seen| seen.message_id.as_slice() == message_id.0.as_slice())
+        {
+            return;
+        }
+        if self.seen.len() == MAX_SEEN_MESSAGES {
+            self.seen.pop_front();
+        }
+        self.seen.push_back(SeenMessage {
+            message_id: message_id.0.clone(),
+            seen_at: now,
+        });
+    }
+
+    pub fn note_local_publish(&mut self, message_id: &MessageId, now: Instant) {
+        if self.observer_peer.is_none() {
+            return;
+        }
+        self.prune_local_published(now);
+        if self
+            .local_published
+            .iter()
+            .any(|seen| seen.message_id.as_slice() == message_id.0.as_slice())
+        {
+            return;
+        }
+        if self.local_published.len() == MAX_SEEN_MESSAGES {
+            self.local_published.pop_front();
+        }
+        self.local_published.push_back(SeenMessage {
+            message_id: message_id.0.clone(),
+            seen_at: now,
+        });
+    }
+
+    pub fn prepare_probe(
+        &mut self,
+        message_id: &MessageId,
+        observer_connected: bool,
+    ) -> Option<ReceiptRequest> {
+        self.observer_peer?;
+        if !observer_connected {
+            self.metrics
+                .probes_skipped_disconnected
+                .fetch_add(1, Ordering::Relaxed);
+            return None;
+        }
+        if self.pending.len() >= MAX_PENDING_RECEIPTS {
+            self.metrics
+                .probes_dropped_capacity
+                .fetch_add(1, Ordering::Relaxed);
+            return None;
+        }
+
+        let mut correlation_id = [0u8; 16];
+        let mut nonce = [0u8; 32];
+        self.rng.fill_bytes(&mut correlation_id);
+        self.rng.fill_bytes(&mut nonce);
+        let blinded_tag = blinded_tag(&nonce, message_id.0.as_slice());
+        let signal_generation = self.next_signal_generation;
+        self.next_signal_generation = self.next_signal_generation.saturating_add(1);
+
+        Some(ReceiptRequest::Probe {
+            correlation_id,
+            nonce,
+            blinded_tag,
+            signal_generation,
+        })
+    }
+
+    pub fn schedule_probe(
+        &mut self,
+        message_id: &MessageId,
+        observer_connected: bool,
+        now: Instant,
+    ) -> bool {
+        if self.observer_peer.is_none() {
+            return false;
+        }
+        if !observer_connected {
+            self.metrics
+                .probes_skipped_disconnected
+                .fetch_add(1, Ordering::Relaxed);
+            return false;
+        }
+        if self.scheduled.len().saturating_add(self.pending.len()) >= MAX_PENDING_RECEIPTS {
+            self.metrics
+                .probes_dropped_capacity
+                .fetch_add(1, Ordering::Relaxed);
+            return false;
+        }
+        self.scheduled.push_back(ScheduledProbe {
+            message_id: message_id.clone(),
+            scheduled_at: now,
+            due_at: now + RECEIPT_PROBE_DELAY,
+        });
+        self.metrics
+            .probes_scheduled
+            .fetch_add(1, Ordering::Relaxed);
+        true
+    }
+
+    pub fn take_due_probe(
+        &mut self,
+        observer_connected: bool,
+        now: Instant,
+    ) -> Option<(PeerId, ReceiptRequest, Instant)> {
+        let observer_peer = self.observer_peer?;
+        if self
+            .scheduled
+            .front()
+            .is_none_or(|scheduled| scheduled.due_at > now)
+        {
+            return None;
+        }
+        let scheduled = self.scheduled.pop_front()?;
+        if !observer_connected {
+            self.metrics
+                .probes_skipped_disconnected
+                .fetch_add(1, Ordering::Relaxed);
+            return None;
+        }
+        self.prepare_probe(&scheduled.message_id, true)
+            .map(|request| (observer_peer, request, scheduled.scheduled_at))
+    }
+
+    pub fn track_probe(
+        &mut self,
+        request_id: OutboundRequestId,
+        peer: PeerId,
+        request: &ReceiptRequest,
+        now: Instant,
+    ) {
+        let ReceiptRequest::Probe {
+            correlation_id,
+            nonce,
+            blinded_tag,
+            signal_generation,
+        } = request;
+        self.pending.insert(
+            request_id,
+            PendingReceipt {
+                peer,
+                correlation_id: *correlation_id,
+                nonce: *nonce,
+                blinded_tag: *blinded_tag,
+                signal_generation: *signal_generation,
+                started_at: now,
+            },
+        );
+        self.metrics.probes_enqueued.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn serve_probe(
+        &mut self,
+        peer: PeerId,
+        request: ReceiptRequest,
+        local_key: &identity::Keypair,
+        now: Instant,
+    ) -> ReceiptResponse {
+        if self.observer_peer != Some(peer) {
+            return ReceiptResponse::Unavailable;
+        }
+        if now.saturating_duration_since(self.serve_window_started) >= SERVE_RATE_WINDOW {
+            self.serve_window_started = now;
+            self.served_in_window = 0;
+        }
+        if self.served_in_window >= MAX_PROBES_PER_SERVE_WINDOW {
+            self.metrics
+                .observer_rate_limited
+                .fetch_add(1, Ordering::Relaxed);
+            return ReceiptResponse::Unavailable;
+        }
+        self.served_in_window = self.served_in_window.saturating_add(1);
+        self.prune_seen(now);
+        let ReceiptRequest::Probe {
+            correlation_id,
+            nonce,
+            blinded_tag,
+            signal_generation,
+        } = request;
+
+        let seen_at = self.seen.iter().find_map(|seen| {
+            let candidate = blinded_tag_for_message(&nonce, seen.message_id.as_slice());
+            constant_time_eq(&candidate, &blinded_tag).then_some(seen.seen_at)
+        });
+        let gossip_seen = seen_at.is_some();
+        let local_duplicate = self.local_published.iter().any(|seen| {
+            let candidate = blinded_tag_for_message(&nonce, seen.message_id.as_slice());
+            constant_time_eq(&candidate, &blinded_tag)
+        });
+        let signal_seen = true;
+        let age_bucket = seen_at
+            .map(|at| age_bucket(now.saturating_duration_since(at)))
+            .unwrap_or(u8::MAX);
+        let signable = signable_receipt(
+            &correlation_id,
+            &nonce,
+            &blinded_tag,
+            signal_generation,
+            signal_seen,
+            gossip_seen,
+            local_duplicate,
+            age_bucket,
+        );
+        let signature = match local_key.sign(&signable) {
+            Ok(signature) => signature,
+            Err(_) => return ReceiptResponse::Unavailable,
+        };
+        let observer_public_key = local_key.public().encode_protobuf();
+
+        self.metrics
+            .observer_probes_served
+            .fetch_add(1, Ordering::Relaxed);
+        self.metrics
+            .observer_signal_received
+            .fetch_add(1, Ordering::Relaxed);
+        if gossip_seen {
+            self.metrics.observer_seen.fetch_add(1, Ordering::Relaxed);
+            self.metrics
+                .observer_gossip_seen
+                .fetch_add(1, Ordering::Relaxed);
+        } else {
+            self.metrics.observer_unseen.fetch_add(1, Ordering::Relaxed);
+        }
+        if local_duplicate {
+            self.metrics
+                .observer_local_duplicate
+                .fetch_add(1, Ordering::Relaxed);
+        }
+
+        ReceiptResponse::Receipt {
+            correlation_id,
+            nonce,
+            blinded_tag,
+            signal_generation,
+            signal_seen,
+            gossip_seen,
+            local_duplicate,
+            age_bucket,
+            observer_public_key,
+            signature,
+        }
+    }
+
+    pub fn handle_response(
+        &mut self,
+        request_id: OutboundRequestId,
+        peer: PeerId,
+        response: ReceiptResponse,
+        now: Instant,
+    ) {
+        let Some(pending) = self.pending.remove(&request_id) else {
+            self.metrics
+                .unmatched_responses
+                .fetch_add(1, Ordering::Relaxed);
+            return;
+        };
+
+        if pending.peer != peer {
+            self.metrics.peer_mismatches.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+
+        let ReceiptResponse::Receipt {
+            correlation_id,
+            nonce,
+            blinded_tag,
+            signal_generation,
+            signal_seen,
+            gossip_seen,
+            local_duplicate,
+            age_bucket,
+            observer_public_key,
+            signature,
+        } = response
+        else {
+            self.metrics
+                .malformed_responses
+                .fetch_add(1, Ordering::Relaxed);
+            return;
+        };
+
+        if correlation_id != pending.correlation_id
+            || nonce != pending.nonce
+            || blinded_tag != pending.blinded_tag
+            || signal_generation != pending.signal_generation
+            || !signal_seen
+            || observer_public_key.is_empty()
+            || observer_public_key.len() > MAX_PUBLIC_KEY_BYTES
+            || signature.is_empty()
+            || signature.len() > MAX_SIGNATURE_BYTES
+            || (gossip_seen && age_bucket > 3)
+            || (!gossip_seen && age_bucket != u8::MAX)
+        {
+            self.metrics
+                .malformed_responses
+                .fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+
+        let public_key = match identity::PublicKey::try_decode_protobuf(&observer_public_key) {
+            Ok(public_key) => public_key,
+            Err(_) => {
+                self.metrics
+                    .malformed_responses
+                    .fetch_add(1, Ordering::Relaxed);
+                return;
+            }
+        };
+        if PeerId::from_public_key(&public_key) != peer {
+            self.metrics.peer_mismatches.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+
+        let signable = signable_receipt(
+            &correlation_id,
+            &nonce,
+            &blinded_tag,
+            signal_generation,
+            signal_seen,
+            gossip_seen,
+            local_duplicate,
+            age_bucket,
+        );
+        if !public_key.verify(&signable, &signature) {
+            self.metrics.bad_signatures.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+
+        self.metrics
+            .remote_signal_seen
+            .fetch_add(1, Ordering::Relaxed);
+        if gossip_seen {
+            self.metrics.remote_seen.fetch_add(1, Ordering::Relaxed);
+            self.metrics
+                .remote_gossip_seen
+                .fetch_add(1, Ordering::Relaxed);
+        } else {
+            self.metrics.remote_unseen.fetch_add(1, Ordering::Relaxed);
+        }
+        if local_duplicate {
+            self.metrics
+                .remote_local_duplicate
+                .fetch_add(1, Ordering::Relaxed);
+        }
+        self.metrics
+            .note_latency(now.saturating_duration_since(pending.started_at));
+    }
+
+    pub fn handle_failure(&mut self, request_id: OutboundRequestId, timed_out: bool) -> bool {
+        if self.pending.remove(&request_id).is_some() {
+            if timed_out {
+                self.metrics.timeouts.fetch_add(1, Ordering::Relaxed);
+            } else {
+                self.metrics
+                    .transport_failures
+                    .fetch_add(1, Ordering::Relaxed);
+            }
+            true
+        } else {
+            false
+        }
+    }
+
+    pub fn prune(&mut self, now: Instant) {
+        self.prune_seen(now);
+        self.prune_local_published(now);
+        let expired_scheduled = self
+            .scheduled
+            .iter()
+            .filter(|scheduled| now.saturating_duration_since(scheduled.due_at) > PENDING_TTL)
+            .count() as u64;
+        self.scheduled.retain(|scheduled| {
+            now.saturating_duration_since(scheduled.due_at) <= PENDING_TTL
+        });
+        let expired = self
+            .pending
+            .values()
+            .filter(|pending| now.saturating_duration_since(pending.started_at) > PENDING_TTL)
+            .count() as u64;
+        self.pending
+            .retain(|_, pending| now.saturating_duration_since(pending.started_at) <= PENDING_TTL);
+        let expired_total = expired.saturating_add(expired_scheduled);
+        if expired_total > 0 {
+            self.metrics
+                .timeouts
+                .fetch_add(expired_total, Ordering::Relaxed);
+        }
+    }
+
+    fn prune_seen(&mut self, now: Instant) {
+        while self
+            .seen
+            .front()
+            .is_some_and(|seen| now.saturating_duration_since(seen.seen_at) > SEEN_TTL)
+        {
+            self.seen.pop_front();
+        }
+    }
+
+    fn prune_local_published(&mut self, now: Instant) {
+        while self.local_published.front().is_some_and(|seen| {
+            now.saturating_duration_since(seen.seen_at) > SEEN_TTL
+        }) {
+            self.local_published.pop_front();
+        }
+    }
+}
+
+fn blinded_tag(nonce: &[u8; 32], message_id: &[u8]) -> [u8; 32] {
+    blinded_tag_for_message(nonce, message_id)
+}
+
+fn blinded_tag_for_message(nonce: &[u8; 32], message_id: &[u8]) -> [u8; 32] {
+    let mut input = Vec::with_capacity(RECEIPT_DOMAIN.len() + message_id.len());
+    input.extend_from_slice(RECEIPT_DOMAIN);
+    input.extend_from_slice(message_id);
+    *blake3::keyed_hash(nonce, &input).as_bytes()
+}
+
+fn signable_receipt(
+    correlation_id: &[u8; 16],
+    nonce: &[u8; 32],
+    blinded_tag: &[u8; 32],
+    signal_generation: u64,
+    signal_seen: bool,
+    gossip_seen: bool,
+    local_duplicate: bool,
+    age_bucket: u8,
+) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(RECEIPT_DOMAIN.len() + 92);
+    bytes.extend_from_slice(RECEIPT_DOMAIN);
+    bytes.extend_from_slice(correlation_id);
+    bytes.extend_from_slice(nonce);
+    bytes.extend_from_slice(blinded_tag);
+    bytes.extend_from_slice(&signal_generation.to_le_bytes());
+    bytes.push(u8::from(signal_seen));
+    bytes.push(u8::from(gossip_seen));
+    bytes.push(u8::from(local_duplicate));
+    bytes.push(age_bucket);
+    bytes
+}
+
+fn constant_time_eq(left: &[u8; 32], right: &[u8; 32]) -> bool {
+    left.iter()
+        .zip(right.iter())
+        .fold(0u8, |diff, (a, b)| diff | (a ^ b))
+        == 0
+}
+
+fn age_bucket(age: Duration) -> u8 {
+    if age <= Duration::from_millis(100) {
+        0
+    } else if age <= Duration::from_millis(500) {
+        1
+    } else if age <= Duration::from_millis(2_000) {
+        2
+    } else {
+        3
+    }
+}
