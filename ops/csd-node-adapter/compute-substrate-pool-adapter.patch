+    async fn connect_gossipsub_pair(left: &mut Swarm<Behaviour>, right: &mut Swarm<Behaviour>) {
+        let left_peer = *left.local_peer_id();
+        let right_peer = *right.local_peer_id();
+        left.behaviour_mut().gossipsub.add_explicit_peer(&right_peer);
+        right.behaviour_mut().gossipsub.add_explicit_peer(&left_peer);
+        left.listen_on("/memory/0".parse().unwrap()).unwrap();
+        let listen_addr = tokio::time::timeout(Duration::from_secs(2), async {
+            loop {
+                if let SwarmEvent::NewListenAddr { address, .. } = left.select_next_some().await {
+                    break address;
+                }
+            }
+        })
+        .await
+        .expect("left swarm must listen");
+        right
+            .dial(listen_addr.with(libp2p::multiaddr::Protocol::P2p(left_peer)))
+            .unwrap();
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            let mut left_saw_right = false;
+            let mut right_saw_left = false;
+            while !(left_saw_right && right_saw_left) {
+                tokio::select! {
+                    event = left.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Subscribed { peer_id, .. }
+                        )) = event {
+                            left_saw_right |= peer_id == right_peer;
+                        }
+                    }
+                    event = right.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Subscribed { peer_id, .. }
+                        )) = event {
+                            right_saw_left |= peer_id == left_peer;
+                        }
+                    }
+                }
+            }
+        })
+        .await
+        .expect("both swarms must observe the remote subscription");
+    }
+
+    fn receipt_replay_header(marker: u8) -> BlockHeader {
+        BlockHeader {
+            version: 1,
+            prev: [marker; 32],
+            merkle: [marker.wrapping_add(1); 32],
+            time: 1_700_100_000 + u64::from(marker),
+            bits: 0x207f_ffff,
+            nonce: u32::from(marker),
+        }
+    }
