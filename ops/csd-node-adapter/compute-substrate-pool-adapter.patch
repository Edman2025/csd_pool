+async fn pool_mining_template(
+    headers: HeaderMap,
+    Query(query): Query<PoolTemplateQuery>,
+    State(st): State<ApiState>,
+) -> Result<Json<PoolTemplateResp>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let miner: Hash20 = parse_addr20(&query.address)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let parent = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        .unwrap_or([0u8; 32]);
+    let parent_hi = if parent == [0u8; 32] {
+        None
+    } else {
+        get_hidx(&st.db, &parent)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+    };
+    let height = parent_hi
+        .as_ref()
+        .map(|header| header.height + 1)
+        .unwrap_or(0);
+    let (mut txs, _, _) =
+        crate::chain::mine::build_template(&st.db, &st.mempool, miner, height, 500)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+
+    txs[0].inputs[0]
+        .script_sig
+        .extend_from_slice(&POOL_EXTRANONCE_PLACEHOLDER);
+    let coinbase_bytes = c()
+        .serialize(&txs[0])
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    let positions = coinbase_bytes
+        .windows(POOL_EXTRANONCE_PLACEHOLDER.len())
+        .enumerate()
+        .filter_map(|(index, bytes)| (bytes == POOL_EXTRANONCE_PLACEHOLDER).then_some(index))
+        .collect::<Vec<_>>();
+    if positions.len() != 1 {
+        return Err(pool_api_error(
+            StatusCode::INTERNAL_SERVER_ERROR,
+            "coinbase extranonce placeholder is not unique",
+        ));
+    }
+    let split = positions[0];
+    let coinb1 = coinbase_bytes[..split].to_vec();
+    let coinb2 = coinbase_bytes[split + POOL_EXTRANONCE_PLACEHOLDER.len()..].to_vec();
+    let time = crate::chain::mine::choose_pool_block_time(&st.db, &parent, parent_hi.as_ref())
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    if time > u64::from(u32::MAX) {
+        return Err(pool_api_error(
+            StatusCode::INTERNAL_SERVER_ERROR,
+            "block time exceeds Stratum v1 range",
+        ));
+    }
+    let bits = expected_bits(&st.db, height, parent_hi.as_ref())
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    let block = Block {
+        header: BlockHeader {
+            version: 1,
+            prev: parent,
+            merkle: crate::chain::mine::merkle_root(&txs),
+            time,
+            bits,
+            nonce: 0,
+        },
+        txs,
+    };
+    let job_id = hex::encode(header_hash(&block.header));
+    let txids = block.txs.iter().map(txid).collect::<Vec<_>>();
+    let branches = pool_merkle_branch(&txids);
+    let mut prev_be = parent;
+    prev_be.reverse();
+    let mut pdiff1 = [0u8; 32];
+    pdiff1[4] = 0xff;
+    pdiff1[5] = 0xff;
+    let response = PoolTemplateResp {
+        job_id: job_id.clone(),
+        prev_hash_be_hex: hex::encode(prev_be),
+        coinb1_hex: hex::encode(&coinb1),
+        coinb2_hex: hex::encode(&coinb2),
+        merkle_branches_hex: branches.iter().map(hex::encode).collect(),
+        version_hex: format!("{:08x}", 1u32),
+        nbits_hex: format!("{bits:08x}"),
+        ntime_hex: format!("{:08x}", time as u32),
+        clean_jobs: true,
+        share_target_hex: hex::encode(pdiff1),
+        network_target_hex: hex::encode(bits_to_target_bytes(bits)),
+    };
+    {
+        let mut jobs = st.pool_jobs.write().map_err(|_| {
+            pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, "pool job cache poisoned")
+        })?;
+        jobs.retain(|_, job| job.block.header.prev == parent);
+        if jobs.len() >= 32 {
+            jobs.clear();
+        }
+        jobs.insert(
+            job_id.clone(),
+            PoolMiningJob {
+                block,
+                coinb1: coinb1.clone(),
+                coinb2: coinb2.clone(),
+                height,
+                template: response.clone(),
+            },
+        );
+    }
+    Ok(Json(response))
+}
+
+async fn pool_mining_template_material(
+    headers: HeaderMap,
+    Query(query): Query<PoolTemplateMaterialQuery>,
+    State(st): State<ApiState>,
+) -> Result<Json<PoolTemplateMaterialResp>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let job = st
+        .pool_jobs
+        .read()
+        .map_err(|_| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, "pool job cache poisoned"))?
+        .get(&query.job_id)
+        .cloned()
+        .ok_or_else(|| pool_api_error(StatusCode::CONFLICT, "stale or unknown pool job"))?;
+    let bytes = c()
+        .serialize(&job.block)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    if bytes.len() > crate::params::MAX_BLOCK_BYTES {
+        return Err(pool_api_error(
+            StatusCode::INTERNAL_SERVER_ERROR,
+            "cached pool block exceeds consensus size limit",
+        ));
+    }
+    Ok(Json(PoolTemplateMaterialResp {
+        template: job.template,
+        block_template_hex: hex::encode(&bytes),
+        block_template_sha256_hex: hex::encode(Sha256::digest(&bytes)),
+        block_template_bytes: bytes.len() as u64,
+    }))
+}
+
+fn decode_pool_header(value: &str) -> Result<BlockHeader, String> {
+    let bytes = hex::decode(value.strip_prefix("0x").unwrap_or(value))
+        .map_err(|_| "header_hex is invalid hex")?;
+    if bytes.len() != 84 {
+        return Err(format!("header_hex must be 84 bytes, got {}", bytes.len()));
+    }
+    let mut prev = [0u8; 32];
+    prev.copy_from_slice(&bytes[4..36]);
+    let mut merkle = [0u8; 32];
+    merkle.copy_from_slice(&bytes[36..68]);
+    Ok(BlockHeader {
+        version: u32::from_le_bytes(bytes[0..4].try_into().unwrap()),
+        prev,
+        merkle,
+        time: u64::from_le_bytes(bytes[68..76].try_into().unwrap()),
+        bits: u32::from_le_bytes(bytes[76..80].try_into().unwrap()),
+        nonce: u32::from_le_bytes(bytes[80..84].try_into().unwrap()),
+    })
+}
+
+fn normalized_hash(value: &str) -> &str {
+    value.strip_prefix("0x").unwrap_or(value)
+}
+
+fn canonical_chain_contains(db: &Stores, tip: &Hash32, wanted: &Hash32) -> anyhow::Result<bool> {
+    let Some(wanted_header) = get_hidx(db, wanted)? else {
+        return Ok(false);
+    };
+    let Some(mut cursor) = get_hidx(db, tip)? else {
+        return Ok(false);
+    };
+    if cursor.height < wanted_header.height {
+        return Ok(false);
+    }
+    while cursor.height > wanted_header.height {
+        let Some(parent) = get_hidx(db, &cursor.parent)? else {
+            return Ok(false);
+        };
+        cursor = parent;
+    }
+    Ok(cursor.hash == *wanted)
+}
