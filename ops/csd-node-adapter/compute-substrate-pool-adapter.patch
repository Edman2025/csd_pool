+async fn pool_block_submit(
+    headers: HeaderMap,
+    State(st): State<ApiState>,
+    Json(request): Json<PoolCandidateReq>,
+) -> Result<Json<PoolBlockResp>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let request_started = Instant::now();
+    let request_received_unix_ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(u64::MAX);
+    let job = st
+        .pool_jobs
+        .read()
+        .map_err(|_| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, "pool job cache poisoned"))?
+        .get(&request.job_id)
+        .cloned()
+        .ok_or_else(|| pool_api_error(StatusCode::CONFLICT, "stale or unknown pool job"))?;
+    let block = assemble_pool_block(job.block, &job.coinb1, &job.coinb2, &request)?;
+    apply_pool_block(&st, block, request_started, request_received_unix_ms).await
+}
+
+async fn pool_block_submit_full(
+    headers: HeaderMap,
+    State(st): State<ApiState>,
+    Json(request): Json<PoolFullCandidateReq>,
+) -> Result<Json<PoolBlockResp>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let request_started = Instant::now();
+    let request_received_unix_ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(u64::MAX);
+    let encoded = normalized_hash(&request.block_template_hex);
+    if encoded.len() > MAX_STATELESS_TEMPLATE_HEX_LEN || encoded.len() % 2 != 0 {
+        return Err(pool_api_error(
+            StatusCode::PAYLOAD_TOO_LARGE,
+            "block_template_hex exceeds the encoded consensus limit or has odd length",
+        ));
+    }
+    let template_bytes = hex::decode(encoded)
+        .map_err(|_| pool_api_error(StatusCode::BAD_REQUEST, "block_template_hex is invalid"))?;
+    if template_bytes.len() > crate::params::MAX_BLOCK_BYTES
+        || request.block_template_bytes != template_bytes.len() as u64
+    {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block template byte length mismatch",
+        ));
+    }
+    let digest = hex::encode(Sha256::digest(&template_bytes));
+    if !digest.eq_ignore_ascii_case(normalized_hash(&request.block_template_sha256_hex)) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block template sha256 mismatch",
+        ));
+    }
+    let template: Block = c().deserialize(&template_bytes).map_err(|error| {
+        pool_api_error(
+            StatusCode::BAD_REQUEST,
+            format!("block template decode failed: {error}"),
+        )
+    })?;
+    if c().serialize(&template).ok().as_deref() != Some(template_bytes.as_slice()) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block template encoding is not canonical",
+        ));
+    }
+    if !hex::encode(header_hash(&template.header))
+        .eq_ignore_ascii_case(normalized_hash(&request.candidate.job_id))
+    {
+        return Err(pool_api_error(
+            StatusCode::CONFLICT,
+            "job_id does not bind the canonical block template",
+        ));
+    }
+    let template_coinbase = template
+        .txs
+        .first()
+        .ok_or_else(|| pool_api_error(StatusCode::BAD_REQUEST, "block template has no coinbase"))?;
+    let template_coinbase_bytes = c()
+        .serialize(template_coinbase)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let positions = template_coinbase_bytes
+        .windows(POOL_EXTRANONCE_PLACEHOLDER.len())
+        .enumerate()
+        .filter_map(|(index, bytes)| (bytes == POOL_EXTRANONCE_PLACEHOLDER).then_some(index))
+        .collect::<Vec<_>>();
+    if positions.len() != 1 {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block template coinbase placeholder is not unique",
+        ));
+    }
+    let split = positions[0];
+    let coinb1 = &template_coinbase_bytes[..split];
+    let coinb2 = &template_coinbase_bytes[split + POOL_EXTRANONCE_PLACEHOLDER.len()..];
+    let block = assemble_pool_block(template, coinb1, coinb2, &request.candidate)?;
+    apply_pool_block(&st, block, request_started, request_received_unix_ms).await
+}
+
+fn assemble_pool_block(
+    mut block: Block,
+    coinb1: &[u8],
+    coinb2: &[u8],
+    request: &PoolCandidateReq,
+) -> Result<Block, PoolApiError> {
+    let coinbase_bytes = hex::decode(normalized_hash(&request.coinbase_hex))
+        .map_err(|_| pool_api_error(StatusCode::BAD_REQUEST, "coinbase_hex is invalid"))?;
+    if coinbase_bytes.len() != coinb1.len() + 8 + coinb2.len()
+        || !coinbase_bytes.starts_with(coinb1)
+        || !coinbase_bytes.ends_with(coinb2)
+    {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase does not match pool job",
+        ));
+    }
+    let coinbase: Transaction = c().deserialize(&coinbase_bytes).map_err(|error| {
+        pool_api_error(
+            StatusCode::BAD_REQUEST,
+            format!("coinbase decode failed: {error}"),
+        )
+    })?;
+    if c().serialize(&coinbase).ok().as_deref() != Some(coinbase_bytes.as_slice()) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase encoding is not canonical",
+        ));
+    }
+    if !hex::encode(txid(&coinbase))
+        .eq_ignore_ascii_case(normalized_hash(&request.coinbase_txid_hex))
+    {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "coinbase txid mismatch",
+        ));
+    }
+    let header = decode_pool_header(&request.header_hex)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    if header.version != block.header.version
+        || header.prev != block.header.prev
+        || header.time != block.header.time
+        || header.bits != block.header.bits
+    {
+        return Err(pool_api_error(
+            StatusCode::CONFLICT,
+            "header fixed fields do not match pool job",
+        ));
+    }
+    let Some(first) = block.txs.first_mut() else {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "pool job has no coinbase",
+        ));
+    };
+    *first = coinbase;
+    block.header = header;
+    if block.header.merkle != crate::chain::mine::merkle_root(&block.txs) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block merkle root mismatch",
+        ));
+    }
+    let hash = header_hash(&block.header);
+    if !hex::encode(hash).eq_ignore_ascii_case(normalized_hash(&request.hash_hex)) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block hash mismatch",
+        ));
+    }
+    if !pow_ok(&hash, block.header.bits) {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block proof of work failed",
+        ));
+    }
+    Ok(block)
+}
+
+fn persist_index_flush_then_apply<E>(
+    insert: impl FnOnce() -> Result<(), E>,
+    index: impl FnOnce() -> Result<(), E>,
+    flush: impl FnOnce() -> Result<(), E>,
+    apply: impl FnOnce() -> Result<(), E>,
+) -> Result<(), E> {
+    insert()?;
+    index()?;
+    flush()?;
+    apply()
+}
+
+fn relay_failure(status: &str, error: impl Into<String>) -> crate::net::MinedHeaderPublishAck {
+    crate::net::MinedHeaderPublishAck {
+        ok: false,
+        status: status.to_string(),
+        message_id: None,
+        error: Some(error.into()),
+        idempotent: false,
+    }
+}
+
+async fn relay_pool_header_with_timeout(
+    mined_headers: &tokio::sync::mpsc::UnboundedSender<crate::net::MinedHeaderEvent>,
+    full_block_delivery: &FullBlockDeliveryEvidence,
+    hash: Hash32,
+    header: BlockHeader,
+    ack_timeout: std::time::Duration,
+) -> (bool, crate::net::MinedHeaderPublishAck) {
+    let (ack_tx, ack_rx) = tokio::sync::oneshot::channel();
+    let queued = mined_headers
+        .send(crate::net::MinedHeaderEvent {
+            hash,
+            header,
+            ack: Some(ack_tx),
+        })
+        .is_ok();
+    full_block_delivery.note_announce_enqueued(hash, queued);
+    if !queued {
+        return (
+            false,
+            relay_failure(
+                "relay_receiver_closed",
+                "mined header relay receiver is closed",
+            ),
+        );
+    }
+    let ack = match tokio::time::timeout(ack_timeout, ack_rx).await {
+        Ok(Ok(ack)) => ack,
+        Ok(Err(_)) => relay_failure(
+            "relay_ack_closed",
+            "mined header relay ACK sender closed before responding",
+        ),
+        Err(_) => relay_failure(
+            "relay_ack_timeout",
+            format!(
+                "mined header relay ACK timed out after {} ms",
+                ack_timeout.as_millis()
+            ),
+        ),
+    };
+    (true, ack)
+}
+
+async fn relay_pool_header(
+    st: &ApiState,
+    hash: Hash32,
+    header: BlockHeader,
+) -> (bool, crate::net::MinedHeaderPublishAck) {
+    relay_pool_header_with_timeout(
+        &st.mined_headers,
+        &st.full_block_delivery,
+        hash,
+        header,
+        POOL_HEADER_RELAY_ACK_TIMEOUT,
+    )
+    .await
+}
+
+async fn apply_pool_block(
+    st: &ApiState,
+    block: Block,
+    request_started: Instant,
+    request_received_unix_ms: u64,
+) -> Result<Json<PoolBlockResp>, PoolApiError> {
+    let bytes = c()
+        .serialize(&block)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    if bytes.len() > crate::params::MAX_BLOCK_BYTES {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block exceeds consensus size limit",
+        ));
+    }
+    let hash = header_hash(&block.header);
+    let _guard = st.chain_lock.lock();
+    let current_tip = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        .unwrap_or([0u8; 32]);
+    let already_canonical = canonical_chain_contains(&st.db, &current_tip, &hash)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    if already_canonical {
+        let stored = st
+            .db
+            .blocks
+            .get(k_block(&hash))
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+            .ok_or_else(|| pool_api_error(StatusCode::CONFLICT, "tip block bytes are missing"))?;
+        let indexed = get_hidx(&st.db, &hash)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+        if stored.as_ref() != bytes.as_slice() || indexed.is_none() {
+            return Err(pool_api_error(
+                StatusCode::CONFLICT,
+                "existing tip does not match the submitted canonical block",
+            ));
+        }
+        drop(_guard);
+        st.full_block_delivery.note_candidate_persisted(hash);
+        let (relay_queued, relay_ack) = relay_pool_header(st, hash, block.header.clone()).await;
+        let relay_ok = relay_ack.ok;
+        return Ok(Json(PoolBlockResp {
+            ok: relay_ok,
+            hash: Some(hex::encode(hash)),
+            status: if relay_ok {
+                "accepted_relay_recovered".to_string()
+            } else {
+                "accepted_local_relay_failed".to_string()
+            },
+            error: (!relay_ok).then(|| relay_ack.error.clone()).flatten(),
+            node_observability: serde_json::json!({
+                "request_received_unix_ms": request_received_unix_ms,
+                "accept_elapsed_us": request_started.elapsed().as_micros() as u64,
+                "relay_enqueue_elapsed_us": request_started.elapsed().as_micros() as u64,
+                "relay_queued": relay_queued,
+                "local_canonical": true,
+                "canonical_tip": current_tip == hash,
+                "relay_ack": relay_ack,
+                "idempotent": true,
+                "relay_retry": true,
+            }),
+        }));
+    }
+    if current_tip != block.header.prev {
+        return Err(pool_api_error(
+            StatusCode::CONFLICT,
+            "solved pool job is stale",
+        ));
+    }
+    let parent_hi = if current_tip == [0u8; 32] {
+        None
+    } else {
+        get_hidx(&st.db, &current_tip)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+    };
+    persist_index_flush_then_apply(
+        || {
+            st.db
+                .blocks
+                .insert(k_block(&hash), bytes)
+                .map(|_| ())
+                .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))
+        },
+        || {
+            index_header(&st.db, &block.header, parent_hi.as_ref())
+                .map(|_| ())
+                .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))
+        },
+        || {
+            st.db
+                .db
+                .flush()
+                .map(|_| ())
+                .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))
+        },
+        || {
+            maybe_reorg_to(&st.db, &hash, Some(&st.mempool))
+                .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))
+        },
+    )?;
+    let accepted = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        == Some(hash);
+    drop(_guard);
+    let accept_elapsed_us: u64 = request_started
+        .elapsed()
+        .as_micros()
+        .try_into()
+        .unwrap_or(u64::MAX);
+    let (relay_queued, relay_ack, relay_enqueue_elapsed_us) = if accepted {
+        st.mempool.remove_mined_block(&block);
+        st.full_block_delivery.note_candidate_persisted(hash);
+        let enqueue_elapsed_us = Some(
+            request_started
+                .elapsed()
+                .as_micros()
+                .try_into()
+                .unwrap_or(u64::MAX),
+        );
+        let (queued, ack) = relay_pool_header(st, hash, block.header.clone()).await;
+        (queued, Some(ack), enqueue_elapsed_us)
+    } else {
+        (false, None, None)
+    };
+    let relay_ok = relay_ack.as_ref().is_some_and(|ack| ack.ok);
+    let submitted_ok = accepted && relay_ok;
+    let status = if !accepted {
+        "orphaned"
+    } else if relay_ok {
+        "accepted"
+    } else {
+        "accepted_local_relay_failed"
+    };
+    let error = if !accepted {
+        Some("block was not selected as canonical tip".to_string())
+    } else {
+        relay_ack.as_ref().and_then(|ack| ack.error.clone())
+    };
+    Ok(Json(PoolBlockResp {
+        ok: submitted_ok,
+        hash: Some(hex::encode(hash)),
+        status: status.to_string(),
+        error,
+        node_observability: serde_json::json!({
+            "request_received_unix_ms": request_received_unix_ms,
+            "accept_elapsed_us": accept_elapsed_us,
+            "relay_enqueue_elapsed_us": relay_enqueue_elapsed_us,
+            "relay_queued": relay_queued,
+            "local_canonical": accepted,
+            "relay_ack": relay_ack,
+            "idempotent": false,
+        }),
+    }))
+}
+
+async fn pool_block_status(
+    headers: HeaderMap,
+    Query(query): Query<PoolBlockStatusQuery>,
+    State(st): State<ApiState>,
+) -> Result<Json<serde_json::Value>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let wanted = parse_hash32(&query.hash)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let indexed = get_hidx(&st.db, &wanted)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    let tip = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        .unwrap_or([0u8; 32]);
+    let tip_hi = get_hidx(&st.db, &tip)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    let mut cursor = tip;
+    let mut canonical = false;
+    while cursor != [0u8; 32] {
+        if cursor == wanted {
+            canonical = true;
+            break;
+        }
+        let Some(header) = get_hidx(&st.db, &cursor)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        else {
+            break;
+        };
+        cursor = header.parent;
+    }
+    let confirmations = if canonical {
+        match (tip_hi.as_ref(), indexed.as_ref()) {
+            (Some(tip), Some(block)) => tip.height.saturating_sub(block.height).saturating_add(1),
+            _ => 0,
+        }
+    } else {
+        0
+    };
+    let reward = st
+        .db
+        .blocks
+        .get(k_block(&wanted))
+        .ok()
+        .flatten()
+        .and_then(|bytes| c().deserialize::<Block>(&bytes).ok())
+        .and_then(|block| {
+            block
+                .txs
+                .first()
+                .and_then(|tx| tx.outputs.first())
+                .map(|output| output.value)
+        });
+    let status = if canonical {
+        "seen_on_chain"
+    } else if indexed.is_some() {
+        "orphaned"
+    } else {
+        "submitted"
+    };
+    Ok(Json(serde_json::json!({
+        "hash": hex::encode(wanted),
+        "status": status,
+        "height": indexed.map(|header| header.height),
+        "confirmations": confirmations,
+        "reward_base_units": reward,
+        "template_height": st.pool_jobs.read().ok().and_then(|jobs| jobs.values().next().map(|job| job.height)),
+    })))
+}
+
+async fn pool_full_block_delivery_status(
+    headers: HeaderMap,
+    Query(query): Query<PoolBlockStatusQuery>,
+    State(st): State<ApiState>,
+) -> Result<Json<serde_json::Value>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let wanted = parse_hash32(&query.hash)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let evidence = st
+        .full_block_delivery
+        .candidate_snapshot(&wanted)
+        .ok_or_else(|| {
+            pool_api_error(
+                StatusCode::NOT_FOUND,
+                "no bounded full-block delivery evidence for candidate",
+            )
+        })?;
+    Ok(Json(serde_json::json!({
+        "ok": true,
+        "full_block_delivery": evidence,
+    })))
 }
 
