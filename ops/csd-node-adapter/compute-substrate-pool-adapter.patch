+    fn actual_gossipsub_without_peers_fails_closed() {
+        let mut behaviour = actual_gossipsub_without_peers();
+        let result = behaviour.publish(IdentTopic::new(TOPIC_HDR), vec![1, 2, 3]);
+        let ack = classify_header_publish(result);
+        assert!(!ack.ok);
+        assert_eq!(ack.status, "insufficient_peers");
+        assert_eq!(ack.error.as_deref(), Some("InsufficientPeers"));
+    }
+
+    #[tokio::test]
+    async fn actual_gossipsub_peer_ack_corresponds_to_delivered_header() {
+        let mut publisher = actual_gossipsub_swarm();
+        let mut receiver = actual_gossipsub_swarm();
+        let receiver_peer = *receiver.local_peer_id();
+        publisher.listen_on("/memory/0".parse().unwrap()).unwrap();
+        let listen_addr = tokio::time::timeout(Duration::from_secs(2), async {
+            loop {
+                if let SwarmEvent::NewListenAddr { address, .. } =
+                    publisher.select_next_some().await
+                {
+                    break address;
+                }
+            }
+        })
+        .await
+        .expect("publisher must start listening");
+        receiver
+            .dial(listen_addr.with(libp2p::multiaddr::Protocol::P2p(
+                *publisher.local_peer_id(),
+            )))
+            .unwrap();
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                tokio::select! {
+                    event = publisher.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Subscribed { peer_id, .. }
+                        )) = event {
+                            if peer_id == receiver_peer {
+                                break;
+                            }
+                        }
+                    }
+                    _ = receiver.select_next_some() => {}
+                }
+            }
+        })
+        .await
+        .expect("publisher must observe the receiver subscription");
+
+        let header = BlockHeader {
+            version: 1,
+            prev: [0x11; 32],
+            merkle: [0x22; 32],
+            time: 1_700_000_000,
+            bits: 0x207f_ffff,
+            nonce: 42,
+        };
+        let expected = crate::codec::consensus_bincode()
+            .serialize(&GossipHeader {
+                header: header.clone(),
+            })
+            .unwrap();
+        let ack = publish_header(&mut publisher, header);
+        assert!(ack.ok, "actual gossipsub publish failed: {ack:?}");
+        assert_eq!(ack.status, "published");
+        assert!(!ack.idempotent);
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                tokio::select! {
+                    _ = publisher.select_next_some() => {}
+                    event = receiver.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Message { message, .. }
+                        )) = event {
+                            if message.topic.as_str() == TOPIC_HDR && message.data == expected {
+                                break;
+                            }
+                        }
+                    }
+                }
+            }
+        })
+        .await
+        .expect("receiver must observe the published header");
+    }
+
+    #[test]
+    fn message_too_large_is_a_structured_publish_failure() {
+        let ack = classify_header_publish(Err(gossipsub::PublishError::MessageTooLarge));
+        assert!(!ack.ok);
+        assert_eq!(ack.status, "message_too_large");
+    }
