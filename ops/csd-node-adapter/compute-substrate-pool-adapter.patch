+    pub protocol_version: u32,
+    pub evidence_semantics: &'static str,
+    pub remote_application_ack_supported: bool,
+    pub remote_receipt_observed: bool,
+    pub full_block_remote_echo_observed: bool,
+    pub tracked_candidates: usize,
+    pub pending_requests: usize,
+    pub candidates_registered: u64,
+    pub candidates_evicted: u64,
+    pub announce_enqueued: u64,
+    pub announce_publish_complete: u64,
+    pub announce_publish_failed: u64,
+    pub external_requests: u64,
+    pub payload_prepared: u64,
+    pub payload_enqueued: u64,
+    pub payload_write_complete: u64,
+    pub negative_responses: u64,
+    pub timeouts: u64,
+    pub transport_failures: u64,
+    pub abnormal: u64,
+    pub telemetry_drops: u64,
+    pub unknown_block_requests: u64,
+    pub conservation_ok: bool,
+    pub bounded_candidates: usize,
+    pub bounded_pending_requests: usize,
+    pub peer_evidence_storage: &'static str,
+}
+
+impl Default for FullBlockDeliveryEvidence {
+    fn default() -> Self {
+        let mut salt = [0u8; 32];
+        OsRng.fill_bytes(&mut salt);
+        Self {
+            salt,
+            inner: Mutex::new(EvidenceInner::default()),
+        }
+    }
+}
+
+impl FullBlockDeliveryEvidence {
+    fn blind(&self, domain: &[u8], value: &[u8]) -> BlindKey {
+        let mut hasher = blake3::Hasher::new_keyed(&self.salt);
+        hasher.update(domain);
+        hasher.update(value);
+        let digest = hasher.finalize();
+        let mut key = [0u8; 16];
+        key.copy_from_slice(&digest.as_bytes()[..16]);
+        key
+    }
+
+    fn candidate_key(&self, hash: &Hash32) -> BlindKey {
+        self.blind(b"csd-v13-full-block-candidate", hash)
+    }
+
+    fn peer_key(&self, peer: &PeerId) -> BlindKey {
+        self.blind(b"csd-v13-full-block-peer", &peer.to_bytes())
+    }
+
+    pub fn note_candidate_persisted(&self, hash: Hash32) {
+        self.note_candidate_persisted_at(hash, Instant::now());
+    }
+
+    fn note_candidate_persisted_at(&self, hash: Hash32, now: Instant) {
+        let key = self.candidate_key(&hash);
+        let mut inner = self.inner.lock();
+        if let Some(candidate) = inner.candidates.get_mut(&key) {
+            candidate.persisted = true;
+            return;
+        }
+
+        while inner.candidates.len() >= MAX_TRACKED_CANDIDATES {
+            let Some(evicted) = inner.order.pop_front() else {
+                break;
+            };
+            let pending_ids = inner
+                .pending
+                .iter()
+                .filter_map(|(request_id, pending)| {
+                    (pending.candidate == evicted).then_some(request_id.clone())
+                })
+                .collect::<Vec<_>>();
+            for request_id in pending_ids {
+                inner.pending.remove(&request_id);
+                inner.aggregate.abnormal = inner.aggregate.abnormal.saturating_add(1);
+            }
+            if inner.candidates.remove(&evicted).is_some() {
+                inner.aggregate.candidates_evicted =
+                    inner.aggregate.candidates_evicted.saturating_add(1);
+            }
+        }
+
+        inner.next_generation = inner.next_generation.saturating_add(1);
+        let generation = inner.next_generation;
+        inner.candidates.insert(
+            key,
+            CandidateEvidence {
+                generation,
+                created_at: Some(now),
+                persisted: true,
+                ..CandidateEvidence::default()
+            },
+        );
+        inner.order.push_back(key);
+        inner.aggregate.candidates_registered =
+            inner.aggregate.candidates_registered.saturating_add(1);
+    }
+
+    pub fn note_announce_enqueued(&self, hash: Hash32, queued: bool) {
+        let key = self.candidate_key(&hash);
+        let mut inner = self.inner.lock();
+        if let Some(candidate) = inner.candidates.get_mut(&key) {
+            if queued && !candidate.announce_enqueued {
+                candidate.announce_enqueued = true;
+                inner.aggregate.announce_enqueued =
+                    inner.aggregate.announce_enqueued.saturating_add(1);
+            } else if !queued {
+                candidate.announce_publish_failed =
+                    candidate.announce_publish_failed.saturating_add(1);
+                inner.aggregate.announce_publish_failed =
+                    inner.aggregate.announce_publish_failed.saturating_add(1);
+            }
+        }
+    }
+
+    pub fn note_announce_publish_complete(&self, hash: Hash32, published: bool) {
+        let key = self.candidate_key(&hash);
+        let mut inner = self.inner.lock();
+        if let Some(candidate) = inner.candidates.get_mut(&key) {
+            if published && !candidate.announce_publish_complete {
+                candidate.announce_publish_complete = true;
+                inner.aggregate.announce_publish_complete =
+                    inner.aggregate.announce_publish_complete.saturating_add(1);
+            } else if !published {
+                candidate.announce_publish_failed =
+                    candidate.announce_publish_failed.saturating_add(1);
+                inner.aggregate.announce_publish_failed =
+                    inner.aggregate.announce_publish_failed.saturating_add(1);
+            }
+        }
+    }
+
+    pub fn note_external_request(
+        &self,
+        hash: Hash32,
+        peer: &PeerId,
+        request_id: InboundRequestId,
+    ) -> bool {
+        self.note_external_request_key(hash, peer, request_id.to_string(), Instant::now())
+    }
+
+    fn note_external_request_key(
+        &self,
+        hash: Hash32,
+        peer: &PeerId,
+        request_id: String,
+        now: Instant,
+    ) -> bool {
+        let candidate_key = self.candidate_key(&hash);
+        let peer_key = self.peer_key(peer);
+        let mut inner = self.inner.lock();
+        if !inner.candidates.contains_key(&candidate_key) {
+            inner.aggregate.unknown_block_requests =
+                inner.aggregate.unknown_block_requests.saturating_add(1);
+            return false;
+        }
+
+        let pending_capacity_exhausted =
+            inner.pending.len() >= MAX_PENDING_REQUESTS || inner.pending.contains_key(&request_id);
+        inner.aggregate.external_requests = inner.aggregate.external_requests.saturating_add(1);
+        let candidate = inner.candidates.get_mut(&candidate_key).unwrap();
+        candidate.external_requests = candidate.external_requests.saturating_add(1);
+        candidate.first_request_latency_us.get_or_insert_with(|| {
+            candidate
+                .created_at
+                .map(|created| now.saturating_duration_since(created).as_micros() as u64)
+                .unwrap_or(0)
+        });
+        if candidate.distinct_peers.len() < MAX_DISTINCT_PEERS_PER_CANDIDATE {
+            candidate.distinct_peers.insert(peer_key);
+        } else if !candidate.distinct_peers.contains(&peer_key) {
+            candidate.distinct_peer_count_saturated = true;
+        }
+
+        if pending_capacity_exhausted {
+            candidate.telemetry_drops = candidate.telemetry_drops.saturating_add(1);
+            inner.aggregate.telemetry_drops = inner.aggregate.telemetry_drops.saturating_add(1);
+            return false;
+        }
+
+        candidate.outstanding = candidate.outstanding.saturating_add(1);
+        inner.pending.insert(
+            request_id,
+            PendingRequest {
+                candidate: candidate_key,
+                response: PendingResponse::Pending,
+            },
+        );
+        true
+    }
+
+    pub fn note_payload_prepared(&self, request_id: InboundRequestId) {
+        self.note_payload_prepared_key(&request_id.to_string());
+    }
+
+    fn note_payload_prepared_key(&self, request_id: &str) {
+        let mut inner = self.inner.lock();
+        let Some(candidate_key) = inner.pending.get_mut(request_id).map(|pending| {
+            pending.response = PendingResponse::PayloadPrepared;
+            pending.candidate
+        }) else {
+            return;
+        };
+        if let Some(candidate) = inner.candidates.get_mut(&candidate_key) {
+            candidate.payload_prepared = candidate.payload_prepared.saturating_add(1);
+            inner.aggregate.payload_prepared = inner.aggregate.payload_prepared.saturating_add(1);
+        }
+    }
+
+    pub fn note_response_enqueued(&self, request_id: InboundRequestId, sent: bool) {
+        self.note_response_enqueued_key(&request_id.to_string(), sent);
+    }
+
+    fn note_response_enqueued_key(&self, request_id: &str, sent: bool) {
+        let mut inner = self.inner.lock();
+        if !sent {
+            Self::finish_transport_failure(&mut inner, request_id);
+            return;
+        }
+        let Some((candidate_key, payload)) = inner.pending.get_mut(request_id).map(|pending| {
+            let payload = matches!(pending.response, PendingResponse::PayloadPrepared);
+            pending.response = if payload {
+                PendingResponse::PayloadEnqueued
+            } else {
+                PendingResponse::NegativeEnqueued
+            };
+            (pending.candidate, payload)
+        }) else {
+            return;
+        };
+        if payload {
+            if let Some(candidate) = inner.candidates.get_mut(&candidate_key) {
+                candidate.payload_enqueued = candidate.payload_enqueued.saturating_add(1);
+                inner.aggregate.payload_enqueued =
+                    inner.aggregate.payload_enqueued.saturating_add(1);
+            }
+        }
+    }
+
+    pub fn note_response_sent(&self, request_id: InboundRequestId) {
+        self.note_response_sent_key(&request_id.to_string(), Instant::now());
+    }
+
+    fn note_response_sent_key(&self, request_id: &str, now: Instant) {
+        let mut inner = self.inner.lock();
+        let Some(pending) = inner.pending.remove(request_id) else {
+            return;
+        };
+        let Some(candidate) = inner.candidates.get_mut(&pending.candidate) else {
+            inner.aggregate.abnormal = inner.aggregate.abnormal.saturating_add(1);
+            return;
+        };
+        candidate.outstanding = candidate.outstanding.saturating_sub(1);
+        match pending.response {
+            PendingResponse::PayloadEnqueued => {
+                candidate.payload_write_complete =
+                    candidate.payload_write_complete.saturating_add(1);
+                candidate
+                    .first_write_complete_latency_us
+                    .get_or_insert_with(|| {
+                        candidate
+                            .created_at
+                            .map(|created| {
+                                now.saturating_duration_since(created).as_micros() as u64
+                            })
+                            .unwrap_or(0)
+                    });
+                inner.aggregate.payload_write_complete =
+                    inner.aggregate.payload_write_complete.saturating_add(1);
+            }
+            PendingResponse::NegativeEnqueued => {
+                candidate.negative_responses = candidate.negative_responses.saturating_add(1);
+                inner.aggregate.negative_responses =
+                    inner.aggregate.negative_responses.saturating_add(1);
+            }
+            PendingResponse::Pending | PendingResponse::PayloadPrepared => {
+                candidate.abnormal = candidate.abnormal.saturating_add(1);
+                inner.aggregate.abnormal = inner.aggregate.abnormal.saturating_add(1);
+            }
+        }
+    }
+
+    pub fn note_inbound_failure(
+        &self,
+        request_id: InboundRequestId,
+        timeout: bool,
+        transport: bool,
+    ) {
+        self.note_inbound_failure_key(&request_id.to_string(), timeout, transport);
+    }
+
+    fn note_inbound_failure_key(&self, request_id: &str, timeout: bool, transport: bool) {
+        let mut inner = self.inner.lock();
+        let Some(pending) = inner.pending.remove(request_id) else {
+            return;
+        };
+        let Some(candidate) = inner.candidates.get_mut(&pending.candidate) else {
+            inner.aggregate.abnormal = inner.aggregate.abnormal.saturating_add(1);
+            return;
+        };
+        candidate.outstanding = candidate.outstanding.saturating_sub(1);
+        if timeout {
+            candidate.timeouts = candidate.timeouts.saturating_add(1);
+            inner.aggregate.timeouts = inner.aggregate.timeouts.saturating_add(1);
+        } else if transport {
+            candidate.transport_failures = candidate.transport_failures.saturating_add(1);
+            inner.aggregate.transport_failures =
+                inner.aggregate.transport_failures.saturating_add(1);
+        } else {
+            candidate.abnormal = candidate.abnormal.saturating_add(1);
+            inner.aggregate.abnormal = inner.aggregate.abnormal.saturating_add(1);
+        }
+    }
+
+    fn finish_transport_failure(inner: &mut EvidenceInner, request_id: &str) {
+        let Some(pending) = inner.pending.remove(request_id) else {
+            return;
+        };
+        if let Some(candidate) = inner.candidates.get_mut(&pending.candidate) {
+            candidate.outstanding = candidate.outstanding.saturating_sub(1);
+            candidate.transport_failures = candidate.transport_failures.saturating_add(1);
+            inner.aggregate.transport_failures =
+                inner.aggregate.transport_failures.saturating_add(1);
+        } else {
+            inner.aggregate.abnormal = inner.aggregate.abnormal.saturating_add(1);
+        }
+    }
+
+    pub fn candidate_snapshot(&self, hash: &Hash32) -> Option<FullBlockCandidateEvidenceSnapshot> {
+        self.candidate_snapshot_at(hash, Instant::now())
+    }
+
+    fn candidate_snapshot_at(
+        &self,
+        hash: &Hash32,
+        now: Instant,
+    ) -> Option<FullBlockCandidateEvidenceSnapshot> {
+        let key = self.candidate_key(hash);
+        let inner = self.inner.lock();
+        let candidate = inner.candidates.get(&key)?;
+        let terminal_total = candidate
+            .payload_write_complete
+            .saturating_add(candidate.negative_responses)
+            .saturating_add(candidate.timeouts)
+            .saturating_add(candidate.transport_failures)
+            .saturating_add(candidate.abnormal)
+            .saturating_add(candidate.telemetry_drops);
+        let conservation_ok =
+            candidate.external_requests == terminal_total.saturating_add(candidate.outstanding);
+        let classification = if candidate.negative_responses > 0
+            || candidate.timeouts > 0
+            || candidate.transport_failures > 0
+            || candidate.abnormal > 0
+            || candidate.telemetry_drops > 0
+        {
+            "NEGATIVE"
+        } else if candidate.payload_write_complete > 0 {
+            "DELIVERY_ATTEMPT_ONLY"
+        } else if candidate.external_requests > 0 {
+            "EXTERNAL_PEER_REQUEST_OBSERVED"
+        } else {
+            "NOT_OBSERVABLE_PROTOCOL_NO_ACK"
+        };
+        Some(FullBlockCandidateEvidenceSnapshot {
+            protocol_version: 1,
+            evidence_semantics:
+                "EXTERNAL_GETBLOCK_REQUEST_AND_LOCAL_RESPONSE_FLUSH_NO_REMOTE_APPLICATION_ACK",
+            classification,
+            remote_application_ack_supported: false,
+            remote_receipt_observed: false,
+            full_block_remote_echo_observed: false,
+            candidate_generation: candidate.generation,
+            candidate_age_ms: candidate
+                .created_at
+                .map(|created| now.saturating_duration_since(created).as_millis() as u64)
+                .unwrap_or(0),
+            candidate_persisted: candidate.persisted,
+            announce_enqueued: candidate.announce_enqueued,
+            announce_publish_complete: candidate.announce_publish_complete,
+            announce_publish_failed: candidate.announce_publish_failed,
+            external_requests: candidate.external_requests,
+            distinct_external_peers: candidate.distinct_peers.len(),
+            distinct_peer_count_saturated: candidate.distinct_peer_count_saturated,
+            bounded_distinct_peers_per_candidate: MAX_DISTINCT_PEERS_PER_CANDIDATE,
+            payload_prepared: candidate.payload_prepared,
+            payload_enqueued: candidate.payload_enqueued,
+            payload_write_complete: candidate.payload_write_complete,
+            negative_responses: candidate.negative_responses,
+            timeouts: candidate.timeouts,
+            transport_failures: candidate.transport_failures,
+            abnormal: candidate.abnormal,
+            telemetry_drops: candidate.telemetry_drops,
+            outstanding_requests: candidate.outstanding,
+            terminal_total,
+            conservation_ok,
+            first_request_latency_us: candidate.first_request_latency_us,
+            first_write_complete_latency_us: candidate.first_write_complete_latency_us,
+            peer_evidence_storage: "EPHEMERAL_KEYED_BLIND_COUNTS_ONLY",
+        })
+    }
+
+    pub fn aggregate_snapshot(&self) -> FullBlockDeliveryAggregateSnapshot {
+        let inner = self.inner.lock();
+        let outstanding = inner.pending.len() as u64;
+        let terminal_total = inner
+            .aggregate
+            .payload_write_complete
+            .saturating_add(inner.aggregate.negative_responses)
+            .saturating_add(inner.aggregate.timeouts)
+            .saturating_add(inner.aggregate.transport_failures)
+            .saturating_add(inner.aggregate.abnormal)
+            .saturating_add(inner.aggregate.telemetry_drops);
+        FullBlockDeliveryAggregateSnapshot {
+            protocol_version: 1,
+            evidence_semantics:
+                "EXTERNAL_GETBLOCK_REQUEST_AND_LOCAL_RESPONSE_FLUSH_NO_REMOTE_APPLICATION_ACK",
+            remote_application_ack_supported: false,
+            remote_receipt_observed: false,
+            full_block_remote_echo_observed: false,
+            tracked_candidates: inner.candidates.len(),
+            pending_requests: inner.pending.len(),
+            candidates_registered: inner.aggregate.candidates_registered,
+            candidates_evicted: inner.aggregate.candidates_evicted,
+            announce_enqueued: inner.aggregate.announce_enqueued,
+            announce_publish_complete: inner.aggregate.announce_publish_complete,
+            announce_publish_failed: inner.aggregate.announce_publish_failed,
+            external_requests: inner.aggregate.external_requests,
+            payload_prepared: inner.aggregate.payload_prepared,
+            payload_enqueued: inner.aggregate.payload_enqueued,
+            payload_write_complete: inner.aggregate.payload_write_complete,
+            negative_responses: inner.aggregate.negative_responses,
+            timeouts: inner.aggregate.timeouts,
+            transport_failures: inner.aggregate.transport_failures,
+            abnormal: inner.aggregate.abnormal,
+            telemetry_drops: inner.aggregate.telemetry_drops,
+            unknown_block_requests: inner.aggregate.unknown_block_requests,
+            conservation_ok: inner.aggregate.external_requests
+                == terminal_total.saturating_add(outstanding),
+            bounded_candidates: MAX_TRACKED_CANDIDATES,
+            bounded_pending_requests: MAX_PENDING_REQUESTS,
+            peer_evidence_storage: "EPHEMERAL_KEYED_BLIND_COUNTS_ONLY",
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use libp2p::identity;
+    use std::time::Duration;
+
+    fn evidence() -> FullBlockDeliveryEvidence {
+        FullBlockDeliveryEvidence {
+            salt: [7u8; 32],
+            inner: Mutex::new(EvidenceInner::default()),
+        }
+    }
+
+    fn peer() -> PeerId {
+        PeerId::from(identity::Keypair::generate_ed25519().public())
+    }
+
+    #[test]
+    fn request_and_response_flush_is_delivery_attempt_not_receipt() {
+        let evidence = evidence();
+        let hash = [3u8; 32];
+        let started = Instant::now();
+        let request = "1".to_string();
+        evidence.note_candidate_persisted_at(hash, started);
+        assert!(evidence.note_external_request_key(
+            hash,
+            &peer(),
+            request.clone(),
+            started + Duration::from_millis(25),
+        ));
+        evidence.note_payload_prepared_key(&request);
+        evidence.note_response_enqueued_key(&request, true);
+        evidence.note_response_sent_key(&request, started + Duration::from_millis(40));
+
+        let snapshot = evidence
+            .candidate_snapshot_at(&hash, started + Duration::from_millis(50))
+            .unwrap();
+        assert_eq!(snapshot.classification, "DELIVERY_ATTEMPT_ONLY");
+        assert_eq!(snapshot.external_requests, 1);
+        assert_eq!(snapshot.payload_write_complete, 1);
+        assert_eq!(snapshot.first_request_latency_us, Some(25_000));
+        assert_eq!(snapshot.first_write_complete_latency_us, Some(40_000));
+        assert!(snapshot.conservation_ok);
+        assert!(!snapshot.remote_receipt_observed);
+        assert!(!snapshot.remote_application_ack_supported);
+    }
+
+    #[test]
+    fn no_request_is_protocol_ack_evidence_gap() {
+        let evidence = evidence();
+        let hash = [4u8; 32];
+        evidence.note_candidate_persisted(hash);
+        let snapshot = evidence.candidate_snapshot(&hash).unwrap();
+        assert_eq!(snapshot.classification, "NOT_OBSERVABLE_PROTOCOL_NO_ACK");
+        assert!(snapshot.conservation_ok);
+    }
+
+    #[test]
+    fn distinct_peers_are_counted_without_serialized_identity() {
+        let evidence = evidence();
+        let hash = [5u8; 32];
+        evidence.note_candidate_persisted(hash);
+        let first = peer();
+        let second = peer();
+        assert!(evidence.note_external_request_key(hash, &first, "2".to_string(), Instant::now(),));
+        assert!(evidence.note_external_request_key(hash, &first, "3".to_string(), Instant::now(),));
+        assert!(evidence.note_external_request_key(hash, &second, "4".to_string(), Instant::now(),));
+        let serialized = serde_json::to_string(&evidence.candidate_snapshot(&hash)).unwrap();
+        assert!(serialized.contains("\"distinct_external_peers\":2"));
+        assert!(!serialized.contains(&first.to_string()));
+        assert!(!serialized.contains(&second.to_string()));
+        assert!(!serialized.contains(&hex::encode(hash)));
+    }
+
+    #[test]
+    fn distinct_peer_count_reports_saturation_at_bound() {
+        let evidence = evidence();
+        let hash = [11u8; 32];
+        evidence.note_candidate_persisted(hash);
+        for request in 0..=MAX_DISTINCT_PEERS_PER_CANDIDATE {
+            assert!(evidence.note_external_request_key(
+                hash,
+                &peer(),
+                format!("peer-bound-{request}"),
+                Instant::now(),
+            ));
+        }
+        let snapshot = evidence.candidate_snapshot(&hash).unwrap();
+        assert_eq!(
+            snapshot.distinct_external_peers,
+            MAX_DISTINCT_PEERS_PER_CANDIDATE
+        );
+        assert!(snapshot.distinct_peer_count_saturated);
+        assert_eq!(
+            snapshot.bounded_distinct_peers_per_candidate,
+            MAX_DISTINCT_PEERS_PER_CANDIDATE
+        );
+    }
+
+    #[test]
+    fn inbound_failure_is_negative_and_conserved() {
+        let evidence = evidence();
+        let hash = [6u8; 32];
+        let request = "5".to_string();
+        evidence.note_candidate_persisted(hash);
+        assert!(evidence.note_external_request_key(hash, &peer(), request.clone(), Instant::now(),));
+        evidence.note_inbound_failure_key(&request, false, true);
+        let snapshot = evidence.candidate_snapshot(&hash).unwrap();
+        assert_eq!(snapshot.classification, "NEGATIVE");
+        assert_eq!(snapshot.transport_failures, 1);
+        assert!(snapshot.conservation_ok);
+    }
+
+    #[test]
+    fn negative_response_is_not_payload_delivery() {
+        let evidence = evidence();
+        let hash = [7u8; 32];
+        let request = "7".to_string();
+        evidence.note_candidate_persisted(hash);
+        assert!(evidence.note_external_request_key(hash, &peer(), request.clone(), Instant::now(),));
+        evidence.note_response_enqueued_key(&request, true);
+        evidence.note_response_sent_key(&request, Instant::now());
+        let snapshot = evidence.candidate_snapshot(&hash).unwrap();
+        assert_eq!(snapshot.classification, "NEGATIVE");
+        assert_eq!(snapshot.negative_responses, 1);
+        assert_eq!(snapshot.payload_write_complete, 0);
+        assert!(snapshot.conservation_ok);
+    }
+
+    #[test]
+    fn send_failure_is_negative_transport_evidence() {
+        let evidence = evidence();
+        let hash = [9u8; 32];
+        let request = "8".to_string();
+        evidence.note_candidate_persisted(hash);
+        assert!(evidence.note_external_request_key(hash, &peer(), request.clone(), Instant::now(),));
+        evidence.note_payload_prepared_key(&request);
+        evidence.note_response_enqueued_key(&request, false);
+        let snapshot = evidence.candidate_snapshot(&hash).unwrap();
+        assert_eq!(snapshot.classification, "NEGATIVE");
+        assert_eq!(snapshot.transport_failures, 1);
+        assert_eq!(snapshot.outstanding_requests, 0);
+        assert!(snapshot.conservation_ok);
+    }
+
+    #[test]
+    fn pending_request_is_visible_and_conserved() {
+        let evidence = evidence();
+        let hash = [10u8; 32];
+        evidence.note_candidate_persisted(hash);
+        assert!(evidence.note_external_request_key(hash, &peer(), "9".to_string(), Instant::now(),));
+        let snapshot = evidence.candidate_snapshot(&hash).unwrap();
+        assert_eq!(snapshot.classification, "EXTERNAL_PEER_REQUEST_OBSERVED");
+        assert_eq!(snapshot.outstanding_requests, 1);
+        assert_eq!(snapshot.terminal_total, 0);
+        assert!(snapshot.conservation_ok);
+    }
+
+    #[test]
+    fn candidate_memory_is_bounded_and_eviction_preserves_aggregate() {
+        let evidence = evidence();
+        for marker in 0..=MAX_TRACKED_CANDIDATES {
+            let mut hash = [0u8; 32];
+            hash[..8].copy_from_slice(&(marker as u64).to_be_bytes());
+            evidence.note_candidate_persisted(hash);
+        }
+        let snapshot = evidence.aggregate_snapshot();
+        assert_eq!(snapshot.tracked_candidates, MAX_TRACKED_CANDIDATES);
+        assert_eq!(
+            snapshot.candidates_registered,
+            (MAX_TRACKED_CANDIDATES + 1) as u64
+        );
+        assert_eq!(snapshot.candidates_evicted, 1);
+        assert!(snapshot.conservation_ok);
+    }
+
+    #[test]
+    fn unknown_block_requests_are_not_linked_to_candidate_evidence() {
+        let evidence = evidence();
+        assert!(!evidence.note_external_request_key(
+            [8u8; 32],
+            &peer(),
+            "6".to_string(),
+            Instant::now(),
+        ));
+        let snapshot = evidence.aggregate_snapshot();
+        assert_eq!(snapshot.unknown_block_requests, 1);
+        assert_eq!(snapshot.external_requests, 0);
+        assert!(snapshot.conservation_ok);
+    }
+}
