+
+const MAX_TRACKED_CANDIDATES: usize = 256;
+const MAX_DISTINCT_PEERS_PER_CANDIDATE: usize = 64;
+const MAX_PENDING_REQUESTS: usize = 1024;
+
+type BlindKey = [u8; 16];
+
+#[derive(Clone, Copy)]
+enum PendingResponse {
+    Pending,
+    PayloadPrepared,
+    PayloadEnqueued,
+    NegativeEnqueued,
+}
+
+struct PendingRequest {
+    candidate: BlindKey,
+    response: PendingResponse,
+}
+
+#[derive(Default)]
+struct CandidateEvidence {
+    generation: u64,
+    created_at: Option<Instant>,
+    persisted: bool,
