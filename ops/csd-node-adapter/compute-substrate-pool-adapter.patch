+    #[tokio::test]
+    async fn actual_remote_receipt_follows_real_gossipsub_delivery() {
+        let (mut publisher, _) = actual_gossipsub_swarm();
+        let (mut observer, observer_key) = actual_gossipsub_swarm();
+        let publisher_peer = *publisher.local_peer_id();
+        let observer_peer = *observer.local_peer_id();
+        publisher
+            .behaviour_mut()
+            .gossipsub
+            .add_explicit_peer(&observer_peer);
+        observer
+            .behaviour_mut()
+            .gossipsub
+            .add_explicit_peer(&publisher_peer);
+        let publisher_metrics = Arc::new(ReceiptMetrics::default());
+        let observer_metrics = Arc::new(ReceiptMetrics::default());
+        let mut publisher_receipts =
+            ReceiptState::new(Some(observer_peer), publisher_metrics.clone());
+        let mut observer_receipts =
+            ReceiptState::new(Some(publisher_peer), observer_metrics.clone());
+
+        publisher.listen_on("/memory/0".parse().unwrap()).unwrap();
+        let listen_addr = tokio::time::timeout(Duration::from_secs(2), async {
+            loop {
+                if let SwarmEvent::NewListenAddr { address, .. } =
+                    publisher.select_next_some().await
+                {
+                    break address;
+                }
+            }
+        })
+        .await
+        .expect("publisher must start listening");
+        observer
+            .dial(listen_addr.with(libp2p::multiaddr::Protocol::P2p(
+                publisher_peer,
+            )))
+            .unwrap();
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                tokio::select! {
+                    event = publisher.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                            gossipsub::Event::Subscribed { peer_id, .. }
+                        )) = event {
+                            if peer_id == observer_peer {
+                                break;
+                            }
+                        }
+                    }
+                    _ = observer.select_next_some() => {}
+                }
+            }
+        })
+        .await
+        .expect("publisher must observe observer subscription");
+
+        let header = BlockHeader {
+            version: 1,
+            prev: [0x31; 32],
+            merkle: [0x32; 32],
+            time: 1_700_000_001,
+            bits: 0x207f_ffff,
+            nonce: 43,
+        };
+        let (ack, published_message_id) = publish_header_tracked(&mut publisher, header);
+        assert!(ack.ok, "local publish must complete independently: {ack:?}");
+        let published_message_id = published_message_id.expect("published message id");
+        let scheduled_at = Instant::now();
+        assert!(publisher_receipts.schedule_probe(
+            &published_message_id,
+            true,
+            scheduled_at
+        ));
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            let mut receipt_poll = tokio::time::interval(Duration::from_millis(10));
+            let mut probe_sent = false;
+            let mut gossip_seen = false;
+            loop {
+                tokio::select! {
+                    _ = receipt_poll.tick(), if !probe_sent => {
+                        if let Some((peer, request, scheduled_at)) = publisher_receipts
+                            .take_due_probe(true, Instant::now())
+                        {
+                            assert!(gossip_seen, "delayed probe must not race ahead of gossip");
+                            let request_id = publisher
+                                .behaviour_mut()
+                                .receipt_rr
+                                .send_request(&peer, request.clone());
+                            publisher_receipts.track_probe(
+                                request_id,
+                                peer,
+                                &request,
+                                scheduled_at,
+                            );
+                            probe_sent = true;
+                        }
+                    }
+                    event = observer.select_next_some() => {
+                        match event {
+                            SwarmEvent::Behaviour(OutEvent::Gossipsub(
+                                gossipsub::Event::Message { message_id, message, .. }
+                            )) if message.topic.as_str() == TOPIC_HDR => {
+                                assert_eq!(message_id, published_message_id);
+                                observer_receipts.note_valid_header(
+                                    &message_id,
+                                    Instant::now(),
+                                );
+                                gossip_seen = true;
+                            }
+                            SwarmEvent::Behaviour(OutEvent::Receipt(
+                                request_response::Event::Message {
+                                    peer,
+                                    message: request_response::Message::Request {
+                                        request,
+                                        channel,
+                                        ..
+                                    },
+                                },
+                            )) => {
+                                let response = observer_receipts.serve_probe(
+                                    peer,
+                                    request,
+                                    &observer_key,
+                                    Instant::now(),
+                                );
+                                observer
+                                    .behaviour_mut()
+                                    .receipt_rr
+                                    .send_response(channel, response)
+                                    .expect("receipt response");
+                            }
+                            _ => {}
+                        }
+                    }
+                    event = publisher.select_next_some() => {
+                        if let SwarmEvent::Behaviour(OutEvent::Receipt(
+                            request_response::Event::Message {
+                                peer,
+                                message: request_response::Message::Response {
+                                    request_id,
+                                    response,
+                                },
+                            },
+                        )) = event {
+                            publisher_receipts.handle_response(
+                                request_id,
+                                peer,
+                                response,
+                                Instant::now(),
+                            );
+                            break;
+                        }
+                    }
+                }
+            }
+        })
+        .await
+        .expect("signed remote receipt must return");
+
+        let publisher_snapshot = publisher_metrics.snapshot();
+        assert_eq!(publisher_snapshot.probes_scheduled, 1);
+        assert_eq!(publisher_snapshot.probes_enqueued, 1);
+        assert_eq!(publisher_snapshot.protocol_version, 2);
+        assert_eq!(publisher_snapshot.remote_signal_seen, 1);
+        assert_eq!(publisher_snapshot.remote_seen, 1);
+        assert_eq!(publisher_snapshot.remote_unseen, 0);
+        assert_eq!(publisher_snapshot.bad_signatures, 0);
+        assert_eq!(publisher_snapshot.peer_mismatches, 0);
+        assert_eq!(observer_metrics.snapshot().observer_seen, 1);
+    }
