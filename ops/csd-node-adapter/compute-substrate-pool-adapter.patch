+    #[tokio::test]
+    async fn actual_sync_full_block_flush_remains_delivery_attempt_without_remote_ack() {
+        let (mut sender, _) = actual_gossipsub_swarm();
+        let (mut receiver, _) = actual_gossipsub_swarm();
+        connect_gossipsub_pair(&mut sender, &mut receiver).await;
+        let sender_peer = *sender.local_peer_id();
+        let evidence = FullBlockDeliveryEvidence::default();
+        let block = Block {
+            header: receipt_replay_header(0x31),
+            txs: Vec::new(),
+        };
+        let hash = header_hash(&block.header);
+        evidence.note_candidate_persisted(hash);
+        receiver
+            .behaviour_mut()
+            .rr
+            .send_request(&sender_peer, SyncRequest::GetBlock { hash });
+
+        let (requester_received, sender_flushed) =
+            tokio::time::timeout(Duration::from_secs(3), async {
+                let mut requester_received = false;
+                let mut sender_flushed = false;
+                while !(requester_received && sender_flushed) {
+                    tokio::select! {
+                        event = sender.select_next_some() => {
+                            match event {
+                                SwarmEvent::Behaviour(OutEvent::Rr(
+                                    request_response::Event::Message {
+                                        peer,
+                                        message: request_response::Message::Request {
+                                            request_id,
+                                            request: SyncRequest::GetBlock { hash: requested },
+                                            channel,
+                                        },
+                                    },
+                                )) => {
+                                    assert_eq!(requested, hash);
+                                    assert!(evidence.note_external_request(
+                                        requested,
+                                        &peer,
+                                        request_id,
+                                    ));
+                                    evidence.note_payload_prepared(request_id);
+                                    let sent = sender
+                                        .behaviour_mut()
+                                        .rr
+                                        .send_response(
+                                            channel,
+                                            SyncResponse::Block {
+                                                block: block.clone(),
+                                            },
+                                        )
+                                        .is_ok();
+                                    evidence.note_response_enqueued(request_id, sent);
+                                }
+                                SwarmEvent::Behaviour(OutEvent::Rr(
+                                    request_response::Event::ResponseSent {
+                                        request_id,
+                                        ..
+                                    },
+                                )) => {
+                                    evidence.note_response_sent(request_id);
+                                    sender_flushed = true;
+                                }
+                                _ => {}
+                            }
+                        }
+                        event = receiver.select_next_some() => {
+                            if let SwarmEvent::Behaviour(OutEvent::Rr(
+                                request_response::Event::Message {
+                                    message: request_response::Message::Response {
+                                        response: SyncResponse::Block { block: received },
+                                        ..
+                                    },
+                                    ..
+                                },
+                            )) = event {
+                                assert_eq!(header_hash(&received.header), hash);
+                                requester_received = true;
+                            }
+                        }
+                    }
+                }
+                (requester_received, sender_flushed)
+            })
+            .await
+            .expect("official sync request-response replay must complete");
+
+        assert!(requester_received);
+        assert!(sender_flushed);
+        let snapshot = evidence.candidate_snapshot(&hash).unwrap();
+        assert_eq!(snapshot.classification, "DELIVERY_ATTEMPT_ONLY");
+        assert_eq!(snapshot.payload_write_complete, 1);
+        assert!(!snapshot.remote_receipt_observed);
+        assert!(
+            !snapshot.remote_application_ack_supported,
+            "the sender cannot infer the requester's post-receive validation"
+        );
+    }
