+async fn apply_pool_block(
+    st: &ApiState,
+    block: Block,
+    request_started: Instant,
+    request_received_unix_ms: u64,
+) -> Result<Json<PoolBlockResp>, PoolApiError> {
+    let bytes = c()
+        .serialize(&block)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    if bytes.len() > crate::params::MAX_BLOCK_BYTES {
+        return Err(pool_api_error(
+            StatusCode::BAD_REQUEST,
+            "block exceeds consensus size limit",
+        ));
+    }
+    let hash = header_hash(&block.header);
+    let _guard = st.chain_lock.lock();
+    let current_tip = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        .unwrap_or([0u8; 32]);
+    let already_canonical = canonical_chain_contains(&st.db, &current_tip, &hash)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    if already_canonical {
+        let stored = st
+            .db
+            .blocks
+            .get(k_block(&hash))
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+            .ok_or_else(|| {
+                pool_api_error(StatusCode::CONFLICT, "tip block bytes are missing")
+            })?;
+        let indexed = get_hidx(&st.db, &hash)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+        if stored.as_ref() != bytes.as_slice() || indexed.is_none() {
+            return Err(pool_api_error(
+                StatusCode::CONFLICT,
+                "existing tip does not match the submitted canonical block",
+            ));
+        }
+        drop(_guard);
+        let (relay_queued, relay_ack) =
+            relay_pool_header(st, hash, block.header.clone()).await;
+        let relay_ok = relay_ack.ok;
+        return Ok(Json(PoolBlockResp {
+            ok: relay_ok,
+            hash: Some(hex::encode(hash)),
+            status: if relay_ok {
+                "accepted_relay_recovered".to_string()
+            } else {
+                "accepted_local_relay_failed".to_string()
+            },
+            error: (!relay_ok).then(|| relay_ack.error.clone()).flatten(),
+            node_observability: serde_json::json!({
+                "request_received_unix_ms": request_received_unix_ms,
+                "accept_elapsed_us": request_started.elapsed().as_micros() as u64,
+                "relay_enqueue_elapsed_us": request_started.elapsed().as_micros() as u64,
+                "relay_queued": relay_queued,
+                "local_canonical": true,
+                "canonical_tip": current_tip == hash,
+                "relay_ack": relay_ack,
+                "relay_ack_scope": "local_gossipsub_publish",
+                "relay_connected_peers_observed": st.connected_peers.load(std::sync::atomic::Ordering::Relaxed),
+                "relay_remote_delivery_observed": false,
+                "relay_remote_delivery_evidence": "not_available_without_application_ack",
+                "idempotent": true,
+                "relay_retry": true,
+            }),
+        }));
+    }
+    if current_tip != block.header.prev {
+        return Err(pool_api_error(
+            StatusCode::CONFLICT,
+            "solved pool job is stale",
+        ));
+    }
+    let parent_hi = if current_tip == [0u8; 32] {
+        None
+    } else {
+        get_hidx(&st.db, &current_tip)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+    };
+    persist_index_flush_then_apply(
+        || {
+            st.db
+                .blocks
+                .insert(k_block(&hash), bytes)
+                .map(|_| ())
+                .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))
+        },
+        || {
+            index_header(&st.db, &block.header, parent_hi.as_ref())
+                .map(|_| ())
+                .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))
+        },
+        || {
+            st.db
+                .db
+                .flush()
+                .map(|_| ())
+                .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))
+        },
+        || {
+            maybe_reorg_to(&st.db, &hash, Some(&st.mempool))
+                .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))
+        },
+    )?;
+    let accepted = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        == Some(hash);
+    drop(_guard);
+    let accept_elapsed_us: u64 = request_started
+        .elapsed()
+        .as_micros()
+        .try_into()
+        .unwrap_or(u64::MAX);
+    let (relay_queued, relay_ack, relay_enqueue_elapsed_us) = if accepted {
+        st.mempool.remove_mined_block(&block);
+        let enqueue_elapsed_us = Some(
+            request_started
+                .elapsed()
+                .as_micros()
+                .try_into()
+                .unwrap_or(u64::MAX),
+        );
+        let (queued, ack) = relay_pool_header(st, hash, block.header.clone()).await;
+        (queued, Some(ack), enqueue_elapsed_us)
+    } else {
+        (false, None, None)
+    };
+    let relay_ok = relay_ack.as_ref().is_some_and(|ack| ack.ok);
+    let submitted_ok = accepted && relay_ok;
+    let status = if !accepted {
+        "orphaned"
+    } else if relay_ok {
+        "accepted"
+    } else {
+        "accepted_local_relay_failed"
+    };
+    let error = if !accepted {
+        Some("block was not selected as canonical tip".to_string())
+    } else {
+        relay_ack.as_ref().and_then(|ack| ack.error.clone())
+    };
+    Ok(Json(PoolBlockResp {
+        ok: submitted_ok,
+        hash: Some(hex::encode(hash)),
+        status: status.to_string(),
+        error,
+        node_observability: serde_json::json!({
+            "request_received_unix_ms": request_received_unix_ms,
+            "accept_elapsed_us": accept_elapsed_us,
+            "relay_enqueue_elapsed_us": relay_enqueue_elapsed_us,
+            "relay_queued": relay_queued,
+            "local_canonical": accepted,
+            "relay_ack": relay_ack,
+            "relay_ack_scope": "local_gossipsub_publish",
+            "relay_connected_peers_observed": st.connected_peers.load(std::sync::atomic::Ordering::Relaxed),
+            "relay_remote_delivery_observed": false,
+            "relay_remote_delivery_evidence": "not_available_without_application_ack",
+            "idempotent": false,
+        }),
+    }))
+}
+
+async fn pool_block_status(
+    headers: HeaderMap,
+    Query(query): Query<PoolBlockStatusQuery>,
+    State(st): State<ApiState>,
+) -> Result<Json<serde_json::Value>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let wanted = parse_hash32(&query.hash)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let indexed = get_hidx(&st.db, &wanted)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    let tip = get_tip(&st.db)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        .unwrap_or([0u8; 32]);
+    let tip_hi = get_hidx(&st.db, &tip)
+        .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?;
+    let mut cursor = tip;
+    let mut canonical = false;
+    while cursor != [0u8; 32] {
+        if cursor == wanted {
+            canonical = true;
+            break;
+        }
+        let Some(header) = get_hidx(&st.db, &cursor)
+            .map_err(|error| pool_api_error(StatusCode::INTERNAL_SERVER_ERROR, error))?
+        else {
+            break;
+        };
+        cursor = header.parent;
+    }
+    let confirmations = if canonical {
+        match (tip_hi.as_ref(), indexed.as_ref()) {
+            (Some(tip), Some(block)) => tip.height.saturating_sub(block.height).saturating_add(1),
+            _ => 0,
+        }
+    } else {
+        0
+    };
+    let reward = st
+        .db
+        .blocks
+        .get(k_block(&wanted))
+        .ok()
+        .flatten()
+        .and_then(|bytes| c().deserialize::<Block>(&bytes).ok())
+        .and_then(|block| {
+            block
+                .txs
+                .first()
+                .and_then(|tx| tx.outputs.first())
+                .map(|output| output.value)
+        });
+    let status = if canonical {
+        "seen_on_chain"
+    } else if indexed.is_some() {
+        "orphaned"
+    } else {
+        "submitted"
+    };
+    Ok(Json(serde_json::json!({
+        "hash": hex::encode(wanted),
+        "status": status,
+        "height": indexed.map(|header| header.height),
+        "confirmations": confirmations,
+        "reward_base_units": reward,
+        "template_height": st.pool_jobs.read().ok().and_then(|jobs| jobs.values().next().map(|job| job.height)),
+    })))
+}
+
+async fn pool_block_relay_status(
+    headers: HeaderMap,
+    Query(query): Query<PoolBlockStatusQuery>,
+    State(st): State<ApiState>,
+) -> Result<Json<serde_json::Value>, PoolApiError> {
+    pool_api_auth(&headers)?;
+    let wanted = parse_hash32(&query.hash)
+        .map_err(|error| pool_api_error(StatusCode::BAD_REQUEST, error))?;
+    let snapshot = st.header_relay_receipts.snapshot(&wanted);
+    Ok(Json(serde_json::json!({
+        "ok": true,
+        "hash": hex::encode(wanted),
+        "receipt_protocol_enabled": st.header_receipt_ack_enabled,
+        "receipt_scope": "signed_application_header_receipt",
+        "receipt_semantics": "remote peer attests receipt of a valid header; not proof of full-block validation or canonical acceptance",
+        "remote_delivery_observed": snapshot.as_ref().is_some_and(|value| value.remote_ack_count > 0),
+        "connected_peers_observed": st.connected_peers.load(Ordering::Relaxed),
+        "receipt": snapshot,
+    })))
+}
