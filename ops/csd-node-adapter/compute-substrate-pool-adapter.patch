+fn classify_header_publish(
+    result: std::result::Result<gossipsub::MessageId, gossipsub::PublishError>,
+) -> MinedHeaderPublishAck {
+    match result {
+        Ok(message_id) => MinedHeaderPublishAck {
+            ok: true,
+            status: "published".to_string(),
+            message_id: Some(hex::encode(message_id.0)),
+            error: None,
+            idempotent: false,
+        },
+        Err(gossipsub::PublishError::Duplicate) => MinedHeaderPublishAck {
+            ok: true,
+            status: "already_published".to_string(),
+            message_id: None,
+            error: None,
+            idempotent: true,
+        },
+        Err(error) => {
+            let status = match &error {
+                gossipsub::PublishError::InsufficientPeers => "insufficient_peers",
+                gossipsub::PublishError::MessageTooLarge => "message_too_large",
+                gossipsub::PublishError::SigningError(_) => "signing_error",
+                gossipsub::PublishError::TransformFailed(_) => "transform_failed",
+                gossipsub::PublishError::Duplicate => unreachable!(),
+            };
+            MinedHeaderPublishAck {
+                ok: false,
+                status: status.to_string(),
+                message_id: None,
+                error: Some(error.to_string()),
+                idempotent: false,
+            }
+        }
+    }
