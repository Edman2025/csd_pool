+fn persist_index_flush_then_apply<E>(
+    insert: impl FnOnce() -> Result<(), E>,
+    index: impl FnOnce() -> Result<(), E>,
+    flush: impl FnOnce() -> Result<(), E>,
+    apply: impl FnOnce() -> Result<(), E>,
+) -> Result<(), E> {
+    insert()?;
+    index()?;
+    flush()?;
+    apply()
+}
