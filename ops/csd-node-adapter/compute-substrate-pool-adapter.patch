+                publisher_peer,
+                ReceiptRequest::Probe {
+                    correlation_id: [marker as u8; 16],
+                    nonce: [1u8; 32],
+                    blinded_tag: [2u8; 32],
+                    signal_generation: u64::from(marker),
+                },
+                &observer,
+                now,
+            );
+            assert!(matches!(response, ReceiptResponse::Receipt { .. }));
+        }
+        assert!(matches!(
+            state.serve_probe(
+                publisher_peer,
+                ReceiptRequest::Probe {
+                    correlation_id: [99u8; 16],
+                    nonce: [1u8; 32],
+                    blinded_tag: [2u8; 32],
+                    signal_generation: 99,
+                },
+                &observer,
+                now,
+            ),
+            ReceiptResponse::Unavailable
+        ));
+        assert_eq!(metrics.snapshot().observer_rate_limited, 1);
+    }
+
+    #[test]
+    fn seen_cache_is_bounded_and_expires() {
+        let peer = identity::Keypair::generate_ed25519();
+        let metrics = Arc::new(ReceiptMetrics::default());
+        let mut state = ReceiptState::new(Some(PeerId::from(peer.public())), metrics);
+        let now = Instant::now();
+        for index in 0..(MAX_SEEN_MESSAGES + 20) {
+            state.note_valid_header(&MessageId(index.to_le_bytes().to_vec()), now);
+        }
+        assert_eq!(state.seen.len(), MAX_SEEN_MESSAGES);
+        state.prune(now + SEEN_TTL + Duration::from_millis(1));
+        assert!(state.seen.is_empty());
+    }
+
+    #[test]
+    fn cumulative_latency_buckets_are_monotonic() {
+        let metrics = ReceiptMetrics::default();
+        metrics.note_latency(Duration::from_millis(50));
+        let snapshot = metrics.snapshot();
+        assert_eq!(snapshot.latency_le_100ms, 1);
+        assert_eq!(snapshot.latency_le_500ms, 1);
+        assert_eq!(snapshot.latency_le_2000ms, 1);
+        assert_eq!(snapshot.latency_gt_2000ms, 0);
+    }
+
+    #[test]
+    fn cross_protocol_reordering_is_reclassified_seen_during_grace() {
+        let publisher = identity::Keypair::generate_ed25519();
+        let observer = identity::Keypair::generate_ed25519();
+        let publisher_peer = PeerId::from(publisher.public());
+        let metrics = Arc::new(ReceiptMetrics::default());
+        let mut state = ReceiptState::new(Some(publisher_peer), metrics.clone());
+        let message_id = message_id(71);
+        let request = probe_for(&message_id, 72);
+        let now = Instant::now();
+
+        assert_eq!(
+            state.probe_seen(publisher_peer, &request, now),
+            Some(false)
+        );
+        state.note_probe_deferred();
+        state.note_valid_header(&message_id, now + Duration::from_millis(250));
+        assert_eq!(
+            state.probe_seen(
+                publisher_peer,
+                &request,
+                now + Duration::from_millis(250)
+            ),
+            Some(true)
+        );
+
+        let response = state.serve_probe(
+            publisher_peer,
+            request,
+            &observer,
+            now + Duration::from_millis(250),
+        );
+        assert!(matches!(
+            response,
+            ReceiptResponse::Receipt {
+                signal_seen: true,
+                gossip_seen: true,
+                ..
+            }
+        ));
+        state.note_probe_grace_completed(true);
+        let snapshot = metrics.snapshot();
+        assert_eq!(snapshot.observer_deferred, 1);
+        assert_eq!(snapshot.observer_grace_seen, 1);
+        assert_eq!(snapshot.observer_grace_expired_unseen, 0);
+        assert_eq!(snapshot.observer_seen, 1);
+        assert_eq!(snapshot.observer_unseen, 0);
+    }
+
+    #[test]
+    fn grace_expiry_keeps_true_unseen_distinct_from_transport_failure() {
+        let publisher = identity::Keypair::generate_ed25519();
+        let observer = identity::Keypair::generate_ed25519();
+        let publisher_peer = PeerId::from(publisher.public());
+        let metrics = Arc::new(ReceiptMetrics::default());
+        let mut state = ReceiptState::new(Some(publisher_peer), metrics.clone());
+        let message_id = message_id(81);
+        let request = probe_for(&message_id, 82);
+        let now = Instant::now();
+
+        assert_eq!(
+            state.probe_seen(publisher_peer, &request, now),
+            Some(false)
+        );
+        state.note_probe_deferred();
+        let response = state.serve_probe(
+            publisher_peer,
+            request,
+            &observer,
+            now + RECEIPT_OBSERVER_GRACE,
+        );
+        assert!(matches!(
+            response,
+            ReceiptResponse::Receipt {
+                signal_seen: true,
+                gossip_seen: false,
+                ..
+            }
+        ));
+        state.note_probe_grace_completed(false);
+        let snapshot = metrics.snapshot();
+        assert_eq!(snapshot.observer_deferred, 1);
+        assert_eq!(snapshot.observer_grace_seen, 0);
+        assert_eq!(snapshot.observer_grace_expired_unseen, 1);
+        assert_eq!(snapshot.observer_unseen, 1);
+        assert_eq!(snapshot.transport_failures, 0);
+        assert_eq!(snapshot.timeouts, 0);
+    }
+}
diff --git a/tests/idle_connection_timeout.rs b/tests/idle_connection_timeout.rs
new file mode 100644
index 0000000..6263292
--- /dev/null
+++ b/tests/idle_connection_timeout.rs
@@ -0,0 +1,304 @@
+use futures::{future::join_all, StreamExt};
+use libp2p::{
+    multiaddr::Protocol,
+    noise,
+    swarm::{
+        dial_opts::{DialOpts, PeerCondition},
+        dummy, ConnectionId, SwarmEvent,
+    },
+    tcp, yamux, Multiaddr, Swarm, SwarmBuilder,
+};
+use std::time::Duration;
+use std::{fs, process::Command};
+use tokio::time::timeout;
+
+fn test_swarm(idle_timeout: Duration) -> Swarm<dummy::Behaviour> {
+    SwarmBuilder::with_new_identity()
+        .with_tokio()
+        .with_tcp(
+            tcp::Config::default().nodelay(true),
+            noise::Config::new,
+            yamux::Config::default,
+        )
+        .unwrap()
+        .with_behaviour(|_| dummy::Behaviour)
+        .unwrap()
+        .with_swarm_config(|cfg| cfg.with_idle_connection_timeout(idle_timeout))
+        .build()
+}
+
+async fn connect(
+    listener_timeout: Duration,
+    dialer_timeout: Duration,
+) -> Option<(Swarm<dummy::Behaviour>, Swarm<dummy::Behaviour>)> {
+    let mut listener = test_swarm(listener_timeout);
+    let mut dialer = test_swarm(dialer_timeout);
+    let listener_peer = *listener.local_peer_id();
+
+    listener
+        .listen_on("/ip4/127.0.0.1/tcp/0".parse().unwrap())
+        .unwrap();
+
+    let mut dial_addr: Multiaddr = timeout(Duration::from_secs(2), async {
+        loop {
+            if let SwarmEvent::NewListenAddr { address, .. } = listener.select_next_some().await {
+                break address;
+            }
+        }
+    })
+    .await
+    .expect("listener address");
+    dial_addr.push(Protocol::P2p(listener_peer));
+    dialer.dial(dial_addr).unwrap();
+
+    let established = timeout(Duration::from_millis(500), async {
+        loop {
+            tokio::select! {
+                event = listener.select_next_some() => {
+                    if matches!(event, SwarmEvent::ConnectionEstablished { .. }) {
+                        break;
+                    }
+                }
+                event = dialer.select_next_some() => {
+                    if matches!(event, SwarmEvent::ConnectionEstablished { .. }) {
+                        break;
+                    }
+                }
+            }
+        }
+    })
+    .await
+    .is_ok();
+
+    established.then_some((listener, dialer))
+}
+
+async fn survives(
+    listener: &mut Swarm<dummy::Behaviour>,
+    dialer: &mut Swarm<dummy::Behaviour>,
+    window: Duration,
+) -> bool {
+    timeout(window, async {
+        loop {
+            tokio::select! {
+                event = listener.select_next_some() => {
+                    if matches!(event, SwarmEvent::ConnectionClosed { .. }) {
+                        return false;
+                    }
+                }
+                event = dialer.select_next_some() => {
+                    if matches!(event, SwarmEvent::ConnectionClosed { .. }) {
+                        return false;
+                    }
+                }
+            }
+        }
+    })
+    .await
+    .unwrap_or(true)
+}
+
+async fn wait_for_dialer_established(
+    listener: &mut Swarm<dummy::Behaviour>,
+    dialer: &mut Swarm<dummy::Behaviour>,
+    expected: ConnectionId,
+) {
+    timeout(Duration::from_secs(2), async {
+        loop {
+            tokio::select! {
+                _ = listener.select_next_some() => {}
+                event = dialer.select_next_some() => {
+                    if matches!(
+                        event,
+                        SwarmEvent::ConnectionEstablished { connection_id, .. }
+                            if connection_id == expected
+                    ) {
+                        return;
+                    }
+                }
+            }
+        }
+    })
+    .await
+    .expect("dialer connection established");
+}
+
+async fn wait_for_dialer_closed(
+    listener: &mut Swarm<dummy::Behaviour>,
+    dialer: &mut Swarm<dummy::Behaviour>,
+    expected: ConnectionId,
+) {
+    timeout(Duration::from_secs(2), async {
+        loop {
+            tokio::select! {
+                _ = listener.select_next_some() => {}
+                event = dialer.select_next_some() => {
+                    if matches!(
+                        event,
+                        SwarmEvent::ConnectionClosed { connection_id, .. }
+                            if connection_id == expected
+                    ) {
+                        return;
+                    }
+                }
+            }
+        }
+    })
+    .await
+    .expect("dialer connection closed");
+}
+
+#[tokio::test]
+async fn default_zero_timeout_closes_an_idle_non_mesh_connection() {
+    let (mut listener, mut dialer) = connect(Duration::ZERO, Duration::ZERO)
+        .await
+        .expect("connection established");
+    assert!(!survives(&mut listener, &mut dialer, Duration::from_millis(250)).await);
+}
+
+#[tokio::test]
+async fn configuring_only_the_dialer_does_not_stop_the_listener_from_closing() {
+    let (mut listener, mut dialer) = connect(Duration::ZERO, Duration::from_secs(2))
+        .await
+        .expect("connection established");
+    assert!(!survives(&mut listener, &mut dialer, Duration::from_millis(250)).await);
+}
+
+#[tokio::test]
+async fn configuring_both_sides_keeps_the_idle_connection_alive() {
+    let (mut listener, mut dialer) = connect(Duration::from_secs(2), Duration::from_secs(2))
+        .await
+        .expect("connection established");
+    assert!(survives(&mut listener, &mut dialer, Duration::from_millis(500)).await);
+}
+
+#[tokio::test]
+async fn exact_second_address_can_close_and_redial_while_first_remains_connected() {
+    let mut listener = test_swarm(Duration::from_secs(2));
+    let mut dialer = test_swarm(Duration::from_secs(2));
+    let listener_peer = *listener.local_peer_id();
+
+    listener
+        .listen_on("/ip4/127.0.0.1/tcp/0".parse().unwrap())
+        .unwrap();
+    listener
+        .listen_on("/ip4/127.0.0.1/tcp/0".parse().unwrap())
+        .unwrap();
+
+    let mut addresses = timeout(Duration::from_secs(2), async {
+        let mut addresses = Vec::new();
+        while addresses.len() < 2 {
+            if let SwarmEvent::NewListenAddr { address, .. } = listener.select_next_some().await {
+                if !addresses.contains(&address) {
+                    addresses.push(address);
+                }
+            }
+        }
+        addresses
+    })
+    .await
+    .expect("two listener addresses");
+
+    let address_two = addresses.pop().unwrap();
+    let address_one = addresses.pop().unwrap();
+
+    let first = DialOpts::peer_id(listener_peer)
+        .condition(PeerCondition::Always)
+        .addresses(vec![address_one])
+        .build();
+    let first_id = first.connection_id();
+    dialer.dial(first).unwrap();
+    wait_for_dialer_established(&mut listener, &mut dialer, first_id).await;
+
+    let second = DialOpts::peer_id(listener_peer)
+        .condition(PeerCondition::Always)
+        .addresses(vec![address_two.clone()])
+        .build();
+    let second_id = second.connection_id();
+    dialer.dial(second).unwrap();
+    wait_for_dialer_established(&mut listener, &mut dialer, second_id).await;
+    assert_eq!(
+        dialer
+            .network_info()
+            .connection_counters()
+            .num_established_outgoing(),
+        2
+    );
+
+    assert!(dialer.close_connection(second_id));
+    wait_for_dialer_closed(&mut listener, &mut dialer, second_id).await;
+    assert_eq!(
+        dialer
+            .network_info()
+            .connection_counters()
+            .num_established_outgoing(),
+        1
+    );
+
+    let redial = DialOpts::peer_id(listener_peer)
+        .condition(PeerCondition::Always)
+        .addresses(vec![address_two])
+        .build();
+    let redial_id = redial.connection_id();
+    dialer.dial(redial).unwrap();
+    wait_for_dialer_established(&mut listener, &mut dialer, redial_id).await;
+    assert_eq!(
+        dialer
+            .network_info()
+            .connection_counters()
+            .num_established_outgoing(),
+        2
+    );
+}
+
+#[tokio::test]
+async fn production_idle_timeout_3600_keeps_thirty_pairs_past_130_seconds() {
+    fn open_fd_count() -> usize {
+        fs::read_dir("/proc/self/fd")
+            .or_else(|_| fs::read_dir("/dev/fd"))
+            .expect("fd directory")
+            .count()
+    }
+
+    fn rss_kib() -> u64 {
+        let output = Command::new("ps")
+            .args(["-o", "rss=", "-p", &std::process::id().to_string()])
+            .output()
+            .expect("ps rss");
+        String::from_utf8(output.stdout)
+            .expect("rss utf8")
+            .trim()
+            .parse()
+            .expect("rss integer")
+    }
+
+    let baseline_fd = open_fd_count();
+    let baseline_rss = rss_kib();
+    let idle = Duration::from_secs(3600);
+    let mut pairs = Vec::with_capacity(30);
+    for _ in 0..30 {
+        pairs.push(connect(idle, idle).await.expect("connection established"));
+    }
+
+    let connected_fd = open_fd_count();
+    let connected_rss = rss_kib();
+    println!(
+        "RESOURCE_BOUNDARY|pairs=30|fd_baseline={}|fd_connected={}|fd_delta={}|rss_baseline_kib={}|rss_connected_kib={}|rss_delta_kib={}",
+        baseline_fd,
+        connected_fd,
+        connected_fd.saturating_sub(baseline_fd),
+        baseline_rss,
+        connected_rss,
+        connected_rss.saturating_sub(baseline_rss)
+    );
+
+    let checks = pairs
+        .into_iter()
+        .map(|(mut listener, mut dialer)| async move {
+            survives(&mut listener, &mut dialer, Duration::from_secs(130)).await
+        });
+    let results = timeout(Duration::from_secs(135), join_all(checks))
+        .await
+        .expect("thirty-pair 130s observation");
+    assert!(results.into_iter().all(|kept| kept));
+}
