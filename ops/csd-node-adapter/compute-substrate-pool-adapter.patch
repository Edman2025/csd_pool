+#[cfg(test)]
+mod fast_tip_recheck_tests {
+    use super::*;
+
+    fn peer() -> PeerId {
+        PeerId::from(identity::Keypair::generate_ed25519().public())
+    }
+
+    #[test]
+    fn duplicate_hash_is_deduplicated_and_peer_flood_is_bounded() {
+        let p = peer();
+        let now = Instant::now();
+        let mut pending = HashMap::new();
+        assert!(queue_fast_tip_recheck(&mut pending, p, [1u8; 32], now));
+        assert!(!queue_fast_tip_recheck(&mut pending, p, [1u8; 32], now));
+        for marker in 2..=MAX_FAST_TIP_RECHECKS_PER_PEER as u8 {
+            assert!(queue_fast_tip_recheck(
+                &mut pending,
+                p,
+                [marker; 32],
+                now
+            ));
+        }
+        assert!(!queue_fast_tip_recheck(&mut pending, p, [99u8; 32], now));
+        assert_eq!(pending.len(), MAX_FAST_TIP_RECHECKS_PER_PEER);
+    }
+
+    #[test]
+    fn global_fast_recheck_queue_is_bounded() {
+        let now = Instant::now();
+        let mut pending = HashMap::new();
+        for marker in 0..MAX_FAST_TIP_RECHECKS {
+            let mut hash = [0u8; 32];
+            hash[..8].copy_from_slice(&(marker as u64).to_le_bytes());
+            assert!(queue_fast_tip_recheck(&mut pending, peer(), hash, now));
+        }
+        assert!(!queue_fast_tip_recheck(
+            &mut pending,
+            peer(),
+            [0xff; 32],
+            now
+        ));
+        assert_eq!(pending.len(), MAX_FAST_TIP_RECHECKS);
+    }
+
+    #[test]
+    fn headers_cooldown_is_hash_specific() {
+        let p = peer();
+        let now = Instant::now();
+        let mut cooldowns = HashMap::new();
+        assert!(headers_request_due(p, [1u8; 32], &mut cooldowns, now));
+        note_headers_request(&mut cooldowns, p, [1u8; 32], now);
+        assert!(!headers_request_due(p, [1u8; 32], &mut cooldowns, now));
+        assert!(headers_request_due(p, [2u8; 32], &mut cooldowns, now));
+        note_headers_request(&mut cooldowns, p, [2u8; 32], now);
+        assert!(
+            !headers_request_due(p, [1u8; 32], &mut cooldowns, now),
+            "h1 -> h2 -> h1 must not bypass the tuple cooldown"
+        );
+        assert!(headers_request_due(
+            p,
+            [1u8; 32],
+            &mut cooldowns,
+            now + Duration::from_secs(HEADERS_REQ_COOLDOWN_SECS)
+        ));
+    }
+
+    #[test]
+    fn headers_cooldown_table_is_bounded_fail_closed() {
+        let now = Instant::now();
+        let mut cooldowns = HashMap::new();
+        let p = peer();
+        for marker in 0..MAX_HEADERS_REQUEST_COOLDOWNS {
+            let mut hash = [0u8; 32];
+            hash[..8].copy_from_slice(&(marker as u64).to_le_bytes());
+            cooldowns.insert((p, hash), now);
+        }
+        assert!(!headers_request_due(
+            p,
+            [0xff; 32],
+            &mut cooldowns,
+            now
+        ));
+        assert!(headers_request_due(
+            p,
+            [0xfe; 32],
+            &mut cooldowns,
+            now + Duration::from_secs(HEADERS_REQ_COOLDOWN_SECS)
+        ));
+    }
+
