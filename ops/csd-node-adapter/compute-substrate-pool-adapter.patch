+type PoolApiError = (StatusCode, Json<serde_json::Value>);
+const POOL_EXTRANONCE_PLACEHOLDER: [u8; 8] =
+    [0xfa, 0xce, 0xb0, 0x0c, 0xc5, 0xd0, 0x0d, 0x01];
+const MAX_STATELESS_TEMPLATE_HEX_LEN: usize = crate::params::MAX_BLOCK_BYTES * 2;
+const MAX_STATELESS_FULL_BODY_BYTES: usize = MAX_STATELESS_TEMPLATE_HEX_LEN + 512 * 1024;
+const POOL_HEADER_RELAY_ACK_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(2);
