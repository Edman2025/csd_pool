+fn relay_failure(status: &str, error: impl Into<String>) -> crate::net::MinedHeaderPublishAck {
+    crate::net::MinedHeaderPublishAck {
+        ok: false,
+        status: status.to_string(),
+        message_id: None,
+        error: Some(error.into()),
+        idempotent: false,
+    }
+}
